root = true

[*]
charset = utf-8

# LF im Repository, auch für die Windows-Anwendung. Das Repository wird auf
# Linux- und auf Windows-Agenten gebaut; ein einheitliches Zeilenende ist die
# einzige Einstellung, bei der "dotnet format --verify-no-changes" auf beiden
# Systemen dasselbe Ergebnis liefert. Die Umsetzung auf der Arbeitskopie
# regelt .gitattributes.
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,wxs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh}]
end_of_line = lf

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.cs]
# Sprache / Stil
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Nullability und Qualität als Fehler
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# Sicherheitsrelevante Analyzer härten
dotnet_diagnostic.CA3075.severity = error   # XML External Entity (XXE)
dotnet_diagnostic.CA5350.severity = error   # schwache Kryptographie
dotnet_diagnostic.CA5351.severity = error   # gebrochene Kryptographie
dotnet_diagnostic.CA2100.severity = error
dotnet_diagnostic.CA1416.severity = error   # Plattformkompatibilität

# Geldbeträge: kein float/double – wird zusätzlich per Review geprüft
dotnet_diagnostic.CA1305.severity = warning # IFormatProvider angeben

# In Testprojekten sind einige Regeln unnötig streng
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2007.severity = none
