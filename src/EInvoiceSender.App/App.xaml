<Application x:Class="EInvoiceSender.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EInvoiceSender.App.ViewModels"
             xmlns:conv="clr-namespace:EInvoiceSender.App.Converters">
  <Application.Resources>
    <ResourceDictionary>

      <!--
        Die Gestaltung steht unter UI/Themes. Hier wird sie nur eingehängt;
        Farbwerte, Schriftgrößen und Abstände stehen dort und nirgends sonst.
      -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="UI/Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:DateOnlyConverter x:Key="DateOnly" />
      <conv:FieldOriginConverter x:Key="FieldOrigin" />
      <conv:FieldOriginVisibilityConverter x:Key="FieldOriginVisible" />

      <!--
        Darstellung eines Befundes.

        Ohne diese Vorlage zeigt WPF für jeden Eintrag das Ergebnis von
        ToString(), also den Klassennamen. Genau das war beim ersten Durchlauf
        zu sehen. Die Vorlage steht bewusst hier und nicht am einzelnen
        ItemsControl: Befunde werden an drei Stellen angezeigt (Schritt 1, 2
        und 4), und eine implizite DataTemplate gilt für alle drei zugleich.

        Sie bleibt auch nach der Umstellung auf BorstWerk hier und wandert
        nicht in die Themes: Das ist eine Anzeigevorlage für ein bestimmtes
        ViewModel, kein Gestaltungsbaustein. Die Farben darin kommen jetzt
        aus den Statusbausteinen.

        Barrierefreiheit: Der Schweregrad steht als Wort und als Zeichen da,
        nicht nur als Farbe. AutomationProperties.Name fasst beides mit der
        Meldung zu einem Satz zusammen, damit eine Sprachausgabe den Eintrag
        am Stück vorliest statt in Bruchstücken.
      -->
      <DataTemplate DataType="{x:Type vm:FindingViewModel}">
        <Border Margin="0,4" x:Name="Rahmen"
                Style="{StaticResource BorstWerk.Status.Base}">
          <AutomationProperties.Name>
            <MultiBinding StringFormat="{}{0}: {1}">
              <Binding Path="SeverityLabel" />
              <Binding Path="Message" />
            </MultiBinding>
          </AutomationProperties.Name>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SeverityGlyph}"
                       x:Name="Zeichen"
                       FontWeight="Bold" MinWidth="16" TextAlignment="Center"
                       VerticalAlignment="Top" Margin="0,0,6,0" />

            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SeverityLabel}"
                       x:Name="Schweregrad"
                       FontWeight="SemiBold" MinWidth="62" VerticalAlignment="Top"
                       Margin="0,0,8,0" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Message}"
                       TextWrapping="Wrap" VerticalAlignment="Top" Margin="0" />

            <!-- Immer belegt: enthält mindestens die Regelkennung. -->
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TechnicalDetail}"
                       Style="{StaticResource BorstWerk.Text.Technical}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
          </Grid>
        </Border>

        <!--
          Der Schweregrad färbt Fläche, Rahmen, Zeichen und Wort. Die Farbe
          ist dabei die Zugabe: Zeichen und ausgeschriebener Schweregrad
          stehen unabhängig davon da.
        -->
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Severity}" Value="Error">
            <Setter TargetName="Rahmen" Property="Style"
                    Value="{StaticResource BorstWerk.Status.Error}" />
            <Setter TargetName="Zeichen" Property="Foreground"
                    Value="{StaticResource BorstWerk.Brush.Status.Error}" />
            <Setter TargetName="Schweregrad" Property="Foreground"
                    Value="{StaticResource BorstWerk.Brush.Status.Error}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Severity}" Value="Warning">
            <Setter TargetName="Rahmen" Property="Style"
                    Value="{StaticResource BorstWerk.Status.Warning}" />
            <Setter TargetName="Zeichen" Property="Foreground"
                    Value="{StaticResource BorstWerk.Brush.Status.Warning}" />
            <Setter TargetName="Schweregrad" Property="Foreground"
                    Value="{StaticResource BorstWerk.Brush.Status.Warning}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Severity}" Value="Information">
            <Setter TargetName="Rahmen" Property="Style"
                    Value="{StaticResource BorstWerk.Status.Info}" />
            <Setter TargetName="Zeichen" Property="Foreground"
                    Value="{StaticResource BorstWerk.Brush.Status.Info}" />
            <Setter TargetName="Schweregrad" Property="Foreground"
                    Value="{StaticResource BorstWerk.Brush.Status.Info}" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

    </ResourceDictionary>
  </Application.Resources>
</Application>
