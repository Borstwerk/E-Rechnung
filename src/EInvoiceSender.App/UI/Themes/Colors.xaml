<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Die Farbwerte der Dachmarke BorstWerk und des Produkts E-Rechnung.

    Diese Datei ist die einzige Stelle im Programm, an der ein Farbwert
    ausgeschrieben steht. Alles Weitere arbeitet mit den Pinseln aus
    Brushes.xaml und benennt damit die Bedeutung, nicht den Farbton.

    Warum diese Trennung: Eine Ansicht, in der `#FDECEC` steht, verrät nicht,
    ob das ein Fehlerhintergrund ist oder zufällig dieselbe Farbe. Beim
    nächsten Mal wird daneben getippt, und niemand merkt es.

    Ein dunkler Modus gehört nicht zur Fassung 1.0. Die Namen sind trotzdem
    schon nach Bedeutung vergeben, damit er später nur eine zweite Datei
    braucht und keine Umbenennung quer durch alle Ansichten.
  -->

  <!-- === Dachmarke ============================================== -->

  <!-- Graphit. Grund des App-Symbols und des Kopfbereichs. -->
  <Color x:Key="BorstWerk.Color.Brand.Dark">#0F172A</Color>

  <!-- Warmer Ocker. Der Akzent der Dachmarke, im Zeichen selbst. -->
  <Color x:Key="BorstWerk.Color.Brand.Accent">#D49A00</Color>

  <!-- === Produktfarbe E-Rechnung ================================ -->

  <!--
    Verbindlich aus der Gestaltungsvorgabe. Sie ist ein Akzent für
    Primäraktionen und aktive Zustände, kein Flächenanstrich.
  -->
  <Color x:Key="BorstWerk.Color.ProductAccent">#176B87</Color>
  <Color x:Key="BorstWerk.Color.ProductAccent.Hover">#125771</Color>
  <Color x:Key="BorstWerk.Color.ProductAccent.Pressed">#0E465B</Color>

  <!--
    Sehr helle Tönung derselben Farbe, für ruhige Hinterlegungen wie den
    Kopfbereich eines aktiven Schritts.
  -->
  <Color x:Key="BorstWerk.Color.ProductAccent.Subtle">#E8F1F5</Color>

  <!-- === Flächen und Rahmen ===================================== -->

  <Color x:Key="BorstWerk.Color.Background">#F5F6F8</Color>
  <Color x:Key="BorstWerk.Color.Surface">#FFFFFF</Color>
  <Color x:Key="BorstWerk.Color.Surface.Muted">#F1F3F5</Color>
  <!--
    Zwei Rahmenfarben mit unterschiedlicher Aufgabe – und das ist kein
    Geschmacksunterschied:

    * Border trennt Flächen voneinander, etwa den Rand einer Karte. Ein
      solcher Rahmen trägt keine Information; verschwände er, wäre die
      Oberfläche nur weniger gegliedert. Für ihn gilt keine
      Kontrastanforderung, und er darf deshalb zurückhaltend sein
      (1,4:1 gegen Weiß).
    * Border.Input umgibt Bedienelemente. An ihm erkennt der Benutzer, wo
      ein Eingabefeld anfängt und aufhört. WCAG 2.1, Erfolgskriterium 1.4.11
      verlangt dafür 3:1; dieser Wert erreicht 3,3:1 gegen Weiß und 3,1:1
      gegen die Fensterfläche.

    Ein erster Entwurf verwendete für beides denselben hellen Ton. Ein
    Eingabefeld war damit kaum vom Hintergrund zu unterscheiden.
  -->
  <Color x:Key="BorstWerk.Color.Border">#D6DAE0</Color>
  <Color x:Key="BorstWerk.Color.Border.Input">#858E9B</Color>

  <!-- === Text =================================================== -->

  <!--
    Kontraste gegen die helle Fläche (#FFFFFF), nachgerechnet nach WCAG 2.1:
      Text.Primary    #1B2430 auf Weiß  = 15,7:1
      Text.Secondary  #4A5462 auf Weiß  =  7,7:1
      Text.Muted      #626C7A auf Weiß  =  5,3:1
    Damit liegt auch die kleinste verwendete Schrift über den geforderten
    4,5:1 für Fließtext.
  -->
  <Color x:Key="BorstWerk.Color.Text.Primary">#1B2430</Color>
  <Color x:Key="BorstWerk.Color.Text.Secondary">#4A5462</Color>
  <Color x:Key="BorstWerk.Color.Text.Muted">#626C7A</Color>
  <Color x:Key="BorstWerk.Color.Text.OnAccent">#FFFFFF</Color>
  <Color x:Key="BorstWerk.Color.Text.OnDark">#FFFFFF</Color>

  <!-- === Status ================================================= -->

  <!--
    Die Bedeutung ist familienweit festgelegt: Grün Erfolg, Blau Information,
    Ocker Warnung, Rot Fehler.

    Die Textfarben sind kräftig genug für Fließtext auf der zugehörigen
    hellen Fläche; die Randfarbe trägt die Umrandung. Farbe steht nie allein –
    jeder Befund führt zusätzlich ein Zeichen und den ausgeschriebenen
    Schweregrad.
  -->
  <Color x:Key="BorstWerk.Color.Status.Success">#1E7B34</Color>
  <Color x:Key="BorstWerk.Color.Status.Success.Surface">#EDF7EF</Color>

  <Color x:Key="BorstWerk.Color.Status.Info">#175E8C</Color>
  <Color x:Key="BorstWerk.Color.Status.Info.Surface">#EAF2F9</Color>

  <Color x:Key="BorstWerk.Color.Status.Warning">#8A5A00</Color>
  <Color x:Key="BorstWerk.Color.Status.Warning.Surface">#FDF6E3</Color>

  <Color x:Key="BorstWerk.Color.Status.Error">#A32217</Color>
  <Color x:Key="BorstWerk.Color.Status.Error.Surface">#FDECEC</Color>

  <Color x:Key="BorstWerk.Color.Status.Neutral">#4A5462</Color>
  <Color x:Key="BorstWerk.Color.Status.Neutral.Surface">#F1F3F5</Color>

  <!-- === Herkunft eines Feldinhalts ============================= -->

  <!--
    Der Hinweis „Aus PDF erkannt“ und seinesgleichen. Dunkelgrün, damit er
    sich vom Fließtext abhebt, ohne zu leuchten – und er steht immer als
    Text da, nicht nur als Färbung.
  -->
  <Color x:Key="BorstWerk.Color.FieldOrigin">#2F5D20</Color>

</ResourceDictionary>
