<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Diese Datei bringt mit, was sie braucht.

    WPF löst einen StaticResource-Verweis beim Laden auf und sucht dabei nur
    im eigenen Wörterbuch und in dem, was darüber bereits eingetragen ist.
    Ein Verweis auf ein Geschwisterwörterbuch, das zufällig vorher in
    Theme.xaml eingehängt wurde, funktioniert deshalb nur, solange genau
    diese Reihenfolge gilt – und bricht die Anwendung beim Start, sobald
    jemand die Reihenfolge ändert oder diese Datei einzeln lädt.

    WPF hält geladene Wörterbücher unter ihrer Adresse fest; das mehrfache
    Einhängen kostet daher kaum etwas.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Brushes.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
  </ResourceDictionary.MergedDictionaries>


  <!--
    Karten, Statusflächen und der Rahmen um einen Befund.

    **Die Regel, die hier über allem steht:** Farbe ist nie der einzige
    Träger einer Aussage. Jede Statusfläche bekommt zusätzlich ein Zeichen
    und den ausgeschriebenen Schweregrad; die Stile hier liefern nur den
    Untergrund dazu. Wer eine dieser Flächen verwendet, ohne Text und Zeichen
    danebenzusetzen, hat die Meldung für einen Teil der Anwender gelöscht.

    Die Zuordnung ist familienweit gleich: Grün Erfolg, Blau Information,
    Ocker Warnung, Rot Fehler, Grau neutral.
  -->

  <!--
    Eine Karte. Sparsam einsetzen – Struktur entsteht besser durch Abstände
    als durch einen Wald aus Rahmen.
  -->
  <Style x:Key="BorstWerk.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource BorstWerk.Radius.Medium}" />
    <Setter Property="Padding" Value="{StaticResource BorstWerk.Padding.Card}" />
  </Style>

  <!-- Eine ruhige Fläche ohne eigene Aussage, etwa hinter einer Vorschau. -->
  <Style x:Key="BorstWerk.Card.Muted" TargetType="Border"
         BasedOn="{StaticResource BorstWerk.Card}">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Surface.Muted}" />
  </Style>

  <!-- === Statusflächen ========================================= -->

  <Style x:Key="BorstWerk.Status.Base" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource BorstWerk.Radius.Small}" />
    <Setter Property="Padding" Value="{StaticResource BorstWerk.Padding.Status}" />
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Status.Neutral.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Border}" />
  </Style>

  <Style x:Key="BorstWerk.Status.Error" TargetType="Border"
         BasedOn="{StaticResource BorstWerk.Status.Base}">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Status.Error.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Status.Error}" />
  </Style>

  <Style x:Key="BorstWerk.Status.Warning" TargetType="Border"
         BasedOn="{StaticResource BorstWerk.Status.Base}">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Status.Warning.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Status.Warning}" />
  </Style>

  <Style x:Key="BorstWerk.Status.Success" TargetType="Border"
         BasedOn="{StaticResource BorstWerk.Status.Base}">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Status.Success.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Status.Success}" />
  </Style>

  <Style x:Key="BorstWerk.Status.Info" TargetType="Border"
         BasedOn="{StaticResource BorstWerk.Status.Base}">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Status.Info.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Status.Info}" />
  </Style>

  <!-- === Herkunftshinweis ====================================== -->

  <!--
    „Aus PDF erkannt“ und seinesgleichen. Der Hinweis steht als Text da; die
    Farbe unterscheidet ihn vom Feldinhalt, trägt aber keine eigene Aussage.
    Fiele sie weg, bliebe der Satz vollständig lesbar – so gehört es.
  -->
  <Style x:Key="Herkunftshinweis" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource BorstWerk.FontSize.Technical}" />
    <Setter Property="Foreground" Value="{StaticResource BorstWerk.Brush.FieldOrigin}" />
    <Setter Property="Margin" Value="0,1,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

</ResourceDictionary>
