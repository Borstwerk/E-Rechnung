<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Diese Datei bringt mit, was sie braucht.

    WPF löst einen StaticResource-Verweis beim Laden auf und sucht dabei nur
    im eigenen Wörterbuch und in dem, was darüber bereits eingetragen ist.
    Ein Verweis auf ein Geschwisterwörterbuch, das zufällig vorher in
    Theme.xaml eingehängt wurde, funktioniert deshalb nur, solange genau
    diese Reihenfolge gilt – und bricht die Anwendung beim Start, sobald
    jemand die Reihenfolge ändert oder diese Datei einzeln lädt.

    WPF hält geladene Wörterbücher unter ihrer Adresse fest; das mehrfache
    Einhängen kostet daher kaum etwas.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Brushes.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
    <ResourceDictionary Source="Controls.Buttons.xaml" />
  </ResourceDictionary.MergedDictionaries>


  <!--
    Eingabefelder, Auswahllisten und Kontrollkästchen.

    **Der Rahmen trägt Information.** An ihm erkennt der Benutzer, wo ein Feld
    beginnt. Deshalb Border.Input mit 3,3:1 gegen Weiß und nicht die dezente
    Trennlinie, die für Karten genügt (siehe Colors.xaml).

    **Beschriftung über dem Feld.** Ein Platzhaltertext im Feld verschwindet,
    sobald jemand tippt – und mit ihm die Angabe, was dort hineingehört. Die
    Ansichten setzen die Beschriftung deshalb als eigenen TextBlock darüber;
    die Stile hier gehen davon aus.

    **Fehler nicht allein über Farbe.** Ein rot umrandetes Feld ohne Text sagt
    farbfehlsichtigen Anwendern nichts. Die Regelprüfung schreibt ihre Befunde
    ausgeschrieben in die Befundliste; die Umrandung hier ist die Zugabe, nicht
    die Botschaft.
  -->

  <Style x:Key="BorstWerk.Input.TextBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource BorstWerk.FontSize.Body}" />
    <Setter Property="FontFamily" Value="{StaticResource BorstWerk.FontFamily}" />
    <Setter Property="Foreground" Value="{StaticResource BorstWerk.Brush.Text.Primary}" />
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Border.Input}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource BorstWerk.Padding.Input}" />
    <Setter Property="MinHeight" Value="{StaticResource BorstWerk.Size.ControlHeight}" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Rahmen"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource BorstWerk.Radius.Small}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>

          <ControlTemplate.Triggers>
            <!--
              Der Fokus wird durch einen kräftigeren Rahmen in der
              Produktfarbe angezeigt, nicht durch einen zusätzlichen Ring:
              Bei einem Textfeld ist der Rahmen die natürliche Stelle, und
              ein außen liegender Ring würde in dichten Formularen mit dem
              Nachbarfeld kollidieren.
            -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Rahmen" Property="BorderBrush"
                      Value="{StaticResource BorstWerk.Brush.ProductAccent}" />
              <Setter TargetName="Rahmen" Property="BorderThickness" Value="2" />
              <!--
                Der stärkere Rahmen wächst nach innen, nicht nach außen –
                sonst verschöbe sich beim Fokussieren das ganze Formular um
                einen Pixel.
              -->
              <Setter TargetName="Rahmen" Property="Margin" Value="-1" />
            </Trigger>

            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Rahmen" Property="Background"
                      Value="{StaticResource BorstWerk.Brush.Surface.Muted}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Rahmen" Property="Background"
                      Value="{StaticResource BorstWerk.Brush.Surface.Muted}" />
              <Setter Property="Foreground"
                      Value="{StaticResource BorstWerk.Brush.Text.Muted}" />
            </Trigger>

            <!--
              Validation.HasError greift, sobald eine Bindung einen Fehler
              meldet. Der Text dazu steht in der Befundliste – hier wird er
              nur zusätzlich sichtbar gemacht.
            -->
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Rahmen" Property="BorderBrush"
                      Value="{StaticResource BorstWerk.Brush.Status.Error}" />
              <Setter TargetName="Rahmen" Property="BorderThickness" Value="2" />
              <Setter TargetName="Rahmen" Property="Margin" Value="-1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Vorgabe für jedes Textfeld ohne ausdrücklichen Stil. -->
  <Style TargetType="TextBox" BasedOn="{StaticResource BorstWerk.Input.TextBox}" />

  <!--
    DatePicker und ComboBox behalten ihre Windows-Vorlage. Sie neu zu bauen
    hieße, Kalenderblatt und Auswahlliste samt Tastaturbedienung selbst zu
    verantworten – ein großes Stück Arbeit mit vielen Möglichkeiten, die
    Barrierefreiheit zu verschlechtern. Angeglichen werden Schrift, Höhe und
    Abstand; das genügt für ein einheitliches Bild.
  -->
  <Style TargetType="ComboBox">
    <Setter Property="FontSize" Value="{StaticResource BorstWerk.FontSize.Body}" />
    <Setter Property="FontFamily" Value="{StaticResource BorstWerk.FontFamily}" />
    <Setter Property="MinHeight" Value="{StaticResource BorstWerk.Size.ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource BorstWerk.Padding.Input}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="FontSize" Value="{StaticResource BorstWerk.FontSize.Body}" />
    <Setter Property="FontFamily" Value="{StaticResource BorstWerk.FontFamily}" />
    <Setter Property="MinHeight" Value="{StaticResource BorstWerk.Size.ControlHeight}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="FontSize" Value="{StaticResource BorstWerk.FontSize.Body}" />
    <Setter Property="FontFamily" Value="{StaticResource BorstWerk.FontFamily}" />
    <Setter Property="Foreground" Value="{StaticResource BorstWerk.Brush.Text.Primary}" />
    <Setter Property="Margin" Value="0,6,0,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource BorstWerk.FocusVisual}" />
  </Style>

</ResourceDictionary>
