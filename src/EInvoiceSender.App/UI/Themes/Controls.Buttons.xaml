<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Diese Datei bringt mit, was sie braucht.

    WPF löst einen StaticResource-Verweis beim Laden auf und sucht dabei nur
    im eigenen Wörterbuch und in dem, was darüber bereits eingetragen ist.
    Ein Verweis auf ein Geschwisterwörterbuch, das zufällig vorher in
    Theme.xaml eingehängt wurde, funktioniert deshalb nur, solange genau
    diese Reihenfolge gilt – und bricht die Anwendung beim Start, sobald
    jemand die Reihenfolge ändert oder diese Datei einzeln lädt.

    WPF hält geladene Wörterbücher unter ihrer Adresse fest; das mehrfache
    Einhängen kostet daher kaum etwas.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Brushes.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Spacing.xaml" />
  </ResourceDictionary.MergedDictionaries>


  <!--
    Schaltflächen.

    **Sichtbarer Fokus zuerst.** WPF zeichnet standardmäßig einen dünnen
    gepunkteten Rahmen *innerhalb* des Elements. Auf einer farbigen
    Schaltfläche ist er praktisch unsichtbar. Wer die Anwendung mit der
    Tastatur bedient, sieht dann nicht, wo er ist. Der Fokusring hier liegt
    außen, ist zwei Pixel stark und nimmt die Produktfarbe – gegen die helle
    Fläche sind das 6,0:1, deutlich über den geforderten 3:1.

    **Zugriffstasten bleiben erhalten.** Der ContentPresenter jeder Vorlage
    trägt RecognizesAccessKey="True". Ohne das erschiene aus „_Weiter“ ein
    sichtbarer Unterstrich statt der Zugriffstaste Alt+W, und die
    Tastaturbedienung wäre stillschweigend kaputt.

    **Warum eigene Vorlagen.** Die Windows-Standardschaltfläche lässt sich
    nicht einfärben, ohne ihre Vorlage zu ersetzen; ein gesetztes Background
    wirkt nur, solange die Maus nicht darüber steht. Eine halb umgefärbte
    Schaltfläche ist schlechter als eine ganz eigene.
  -->

  <!--
    Der gemeinsame Fokusring. Liegt außerhalb des Elements, damit er nicht
    von der Füllung verschluckt wird.
  -->
  <Style x:Key="BorstWerk.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" StrokeThickness="2" RadiusX="6" RadiusY="6"
                     Stroke="{StaticResource BorstWerk.Brush.ProductAccent}"
                     SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Grundgerüst beider Schaltflächen. Farben setzen die abgeleiteten Stile;
    hier steht nur, was für beide gilt.
  -->
  <Style x:Key="BorstWerk.Button.Base" TargetType="Button">
    <Setter Property="FontSize" Value="{StaticResource BorstWerk.FontSize.Body}" />
    <Setter Property="FontFamily" Value="{StaticResource BorstWerk.FontFamily}" />
    <Setter Property="Padding" Value="{StaticResource BorstWerk.Padding.Button}" />
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="MinHeight" Value="{StaticResource BorstWerk.Size.ControlHeight}" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource BorstWerk.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fläche"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource BorstWerk.Radius.Small}"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True" />
          </Border>

          <ControlTemplate.Triggers>
            <!--
              Abgeschaltete Schaltflächen werden blasser, behalten aber genug
              Kontrast, um lesbar zu bleiben. Eine Schaltfläche, deren
              Beschriftung man raten muss, erklärt nicht, warum sie gerade
              nicht geht.
            -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fläche" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Die Primäraktion – je Bereich genau eine. Im Ablauf ist das „Weiter“
    beziehungsweise die Schaltfläche, die den Schritt abschließt.
  -->
  <Style x:Key="BorstWerk.Button.Primary" TargetType="Button"
         BasedOn="{StaticResource BorstWerk.Button.Base}">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.ProductAccent}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.ProductAccent}" />
    <Setter Property="Foreground" Value="{StaticResource BorstWerk.Brush.Text.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.ProductAccent.Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.ProductAccent.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.ProductAccent.Pressed}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.ProductAccent.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Alles Übrige: neutral, mit dezentem Rahmen. -->
  <Style x:Key="BorstWerk.Button.Secondary" TargetType="Button"
         BasedOn="{StaticResource BorstWerk.Button.Base}">
    <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorstWerk.Brush.Border.Input}" />
    <Setter Property="Foreground" Value="{StaticResource BorstWerk.Brush.Text.Primary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Surface.Muted}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource BorstWerk.Brush.Border}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Vorgabe für jede Schaltfläche ohne ausdrücklichen Stil. Das ist die
    sekundäre Form: Wer eine Primäraktion will, sagt es.
  -->
  <Style TargetType="Button" BasedOn="{StaticResource BorstWerk.Button.Secondary}" />

</ResourceDictionary>
