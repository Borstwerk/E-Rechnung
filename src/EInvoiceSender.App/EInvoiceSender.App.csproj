<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Die WPF-Anwendung. Enthält Fenster, Ansichten, ViewModels, die
    Windows-spezifischen Dienste und die Zusammenstellung der Abhängigkeiten.
    Fachlogik steht ausschließlich in EInvoiceSender.Core.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EInvoiceSender.App</RootNamespace>
    <AssemblyName>EInvoiceSender</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Das Symbol der Programmdatei. Windows zeigt es im Explorer, in der
      Taskleiste, im Startmenü und in der Titelleiste; das Installationspaket
      verwendet dieselbe Datei für den Eintrag in „Apps und Features“.

      Erzeugt aus der Zeichengeometrie durch build/icon – die Datei wird nicht
      von Hand bearbeitet.
    -->
    <ApplicationIcon>Assets\BorstWerkEInvoice.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Die produktiv ausgelieferte self-contained Windows-Laufzeit wird bewusst
    zusammen mit ihren geprüften Lizenz-/Notice-Unterlagen aktualisiert. Die
    Produktversion bleibt davon unabhängig allein in VersionPrefix.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == 'win-x64' And '$(SelfContained)' == 'true'">
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Zusätzlich als Ressource eingebettet: ApplicationIcon setzt nur das
      Symbol der EXE-Datei. Damit auch das Fenster selbst es tragen kann,
      muss es zur Laufzeit ladbar sein.
    -->
    <Resource Include="Assets\BorstWerkEInvoice.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EInvoiceSender.Core\EInvoiceSender.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="PDFtoImage" />
  </ItemGroup>

</Project>
