<Window x:Class="EInvoiceSender.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EInvoiceSender.App.ViewModels"
        xmlns:steps="clr-namespace:EInvoiceSender.App.Views.Steps"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BorstWerk E-Rechnung"
        Icon="/Assets/BorstWerkEInvoice.ico"
        Background="{StaticResource BorstWerk.Brush.Background}"
        Height="860" Width="1200"
        MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnFileDropped"
        DragOver="OnDragOver">

  <!--
    Das Hauptfenster trägt nur den Rahmen: Kopfzeile, Platz für den aktuellen
    Schritt, Statuszeile und Navigation. Die Schritte selbst sind eigene
    UserControls unter Views/Steps.
  -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      Produktkopf: Zeichen und Produktname, sonst nichts.

      Bewusst schmal gehalten. Der Anwender ist hier, um eine Rechnung zu
      erzeugen; die Marke soll erkennbar sein und dann aus dem Weg gehen.
      Kein Untertitel, kein Anspruch, keine Werbefläche – was über das
      Projekt zu sagen ist, steht unter „Über“.

      Der Kopf ist für die Sprachausgabe ein Element mit einem Namen. Ohne
      das läse sie „Bild“ und danach den Text; so kommt ein Satz heraus.
    -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal"
                  AutomationProperties.Name="BorstWerk E-Rechnung">
        <Image Source="{StaticResource BorstWerk.Logo.OnLight}"
               Width="24" Height="24" VerticalAlignment="Center"
               Margin="0,0,10,0"
               AutomationProperties.Name="BorstWerk"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock VerticalAlignment="Center" Margin="0"
                   FontSize="{StaticResource BorstWerk.FontSize.CardTitle}"
                   Foreground="{StaticResource BorstWerk.Brush.Text.Secondary}">
          <Run Text="BorstWerk" FontWeight="SemiBold"
               Foreground="{StaticResource BorstWerk.Brush.Text.Primary}" /><Run Text=" E-Rechnung" />
        </TextBlock>
      </StackPanel>

      <!--
        Der Info-Bereich sitzt hier und nicht in der Navigation unten: Dort
        stehen die vier Schaltflächen des Arbeitsablaufs, und „Über“ gehört
        nicht dazu. Klein gehalten, weil es beim Rechnungschreiben niemanden
        interessiert.
      -->
      <Button Grid.Column="1" Content="_Über ..." Click="OnAboutClicked" TabIndex="95"
              MinWidth="0" Margin="0" Padding="10,4"
              FontSize="{StaticResource BorstWerk.FontSize.Label}"
              AutomationProperties.HelpText="Zeigt Fassung, Lizenz und Hinweise zur Anwendung." />
    </Grid>

    <!-- Titel des aktuellen Schritts -->
    <TextBlock Grid.Row="1" Text="{Binding StepTitle}"
               Style="{StaticResource BorstWerk.Text.PageTitle}"
               Margin="0,0,0,12"
               AutomationProperties.LiveSetting="Polite" />

    <!-- Globale Störungsanzeige -->
    <Border Grid.Row="2" Style="{StaticResource BorstWerk.Status.Error}" Margin="0,0,0,12"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <!--
          Zeichen und Wort zusätzlich zur Farbe: Eine rot umrandete Fläche
          allein sagt farbfehlsichtigen Anwendern nicht, dass hier ein
          Fehler steht.
        -->
        <TextBlock Text="✕" FontWeight="Bold" MinWidth="16" TextAlignment="Center"
                   VerticalAlignment="Top" Margin="0,0,8,0"
                   Foreground="{StaticResource BorstWerk.Brush.Status.Error}" />
        <TextBlock Text="Fehler" FontWeight="SemiBold" VerticalAlignment="Top"
                   Margin="0,0,8,0"
                   Foreground="{StaticResource BorstWerk.Brush.Status.Error}" />
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </Border>

    <!-- Der aktuelle Schritt -->
    <Grid Grid.Row="3">
      <steps:PdfSelectionView x:Name="ViewSchritt1" DataContext="{Binding PdfSelection}" />
      <steps:InvoiceDataView x:Name="ViewSchritt2" DataContext="{Binding InvoiceData}" />
      <steps:ReviewView x:Name="ViewSchritt3" DataContext="{Binding Review}" />
      <steps:GenerationView x:Name="ViewSchritt4" DataContext="{Binding Generation}" />
      <steps:ResultView x:Name="ViewSchritt5" DataContext="{Binding Result}" />
    </Grid>

    <!-- Statuszeile -->
    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
               Margin="0,16,0,12"
               Foreground="{StaticResource BorstWerk.Brush.Text.Secondary}"
               AutomationProperties.LiveSetting="Polite" />

    <!-- Navigation -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="_Einstellungen ..." Click="OnSettingsClicked" TabIndex="90"
              AutomationProperties.HelpText="Öffnet die Firmenvorlage und die Standardwerte." />
      <Button Content="Neue _Rechnung" Command="{Binding StartOverCommand}" TabIndex="91"
              AutomationProperties.HelpText="Verwirft den aktuellen Stand und beginnt von vorn." />
      <Separator Width="16" Visibility="Hidden" />
      <Button Content="_Zurück" Command="{Binding GoBackCommand}" TabIndex="92" />
      <!--
        Die einzige Primäraktion des Fensters. Sie trägt die Produktfarbe;
        alles andere daneben bleibt neutral, sonst hebt sich nichts mehr ab.
      -->
      <Button Content="_Weiter" Command="{Binding GoForwardCommand}" TabIndex="93" IsDefault="True"
              Style="{StaticResource BorstWerk.Button.Primary}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
