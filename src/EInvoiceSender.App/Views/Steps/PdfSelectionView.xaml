<UserControl x:Class="EInvoiceSender.App.Views.Steps.PdfSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EInvoiceSender.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PdfSelectionViewModel}"
             d:DesignHeight="520" d:DesignWidth="900">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap"
               Text="Ziehen Sie Ihre fertige PDF-Rechnung in dieses Fenster oder wählen Sie sie aus. Die Datei wird nur gelesen und niemals verändert." />

    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="PDF-Rechnung _auswählen ..." Click="OnSelectClicked" TabIndex="1"
              AutomationProperties.HelpText="Öffnet einen Dateidialog zur Auswahl der PDF-Rechnung." />
      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Margin="12,0,0,0" />
    </StackPanel>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SummaryText}" TextWrapping="Wrap"
               Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />

    <!-- Befunde der Eingangsprüfung -->
    <ScrollViewer Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,12,12,0">
      <StackPanel>

        <!--
          Das Angebot der sichtbaren Kopie.

          Kein roter Fehlerzustand: Es gibt einen erprobten Weg, er führt zu
          einer vollständig geprüften E-Rechnung, und der Benutzer muss ihn nur
          wählen. Ein Fehler wäre hier schlicht die falsche Auskunft.

          Was er dabei aufgibt, steht vor der Schaltfläche und nicht danach.
          Kein vorbelegtes Kästchen, keine stille Annahme – die Zustimmung ist
          ein eigener Klick, und ohne sie bleibt „Weiter“ gesperrt.
        -->
        <Border Style="{StaticResource BorstWerk.Status.Warning}" Margin="0,0,0,12"
                AutomationProperties.Name="Sichtbare Kopie erforderlich"
                AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding ShowsRasterFallbackOffer, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚠" FontWeight="Bold" MinWidth="16" TextAlignment="Center"
                         VerticalAlignment="Top" Margin="0,0,8,0"
                         Foreground="{StaticResource BorstWerk.Brush.Status.Warning}" />
              <TextBlock Text="Sichtbare Kopie erforderlich" FontWeight="SemiBold"
                         VerticalAlignment="Top" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="24,6,0,0"
                       Text="Diese PDF kann nicht direkt übernommen werden, weil nicht alle Schriftarten eingebettet sind. BorstWerk E-Rechnung kann stattdessen örtlich eine sichtbare PDF/A-Kopie erzeugen. Das Original bleibt unverändert." />
            <TextBlock TextWrapping="Wrap" Margin="24,6,0,0"
                       Text="Der Text der Seiten ist danach nicht mehr markierbar und in der Anzeige nicht mehr durchsuchbar. Verknüpfungen und Formularfunktionen gehen verloren, die Datei kann größer werden. Die Rechnungsdaten selbst bleiben maschinenlesbar – sie stecken in der eingebetteten XML." />
            <StackPanel Orientation="Horizontal" Margin="24,10,0,0">
              <Button Content="Mit visueller _Kopie fortfahren"
                      Style="{StaticResource BorstWerk.Button.Primary}"
                      Command="{Binding ConfirmRasterFallbackCommand}" TabIndex="2"
                      AutomationProperties.HelpText="Erzeugt die E-Rechnung aus einer sichtbaren Kopie der Seiten. Das Original bleibt unverändert." />
              <!-- Zugriffstaste P: _W gehört „Weiter“, _A der Auswahl darüber. -->
              <Button Content="Andere _PDF wählen ..." Click="OnSelectClicked" TabIndex="3"
                      AutomationProperties.HelpText="Öffnet einen Dateidialog zur Auswahl einer anderen PDF-Rechnung." />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Nach der Zustimmung: kurz, sachlich, sichtbar. -->
        <Border Style="{StaticResource BorstWerk.Status.Info}" Margin="0,0,0,12"
                AutomationProperties.Name="Die sichtbare Kopie wird verwendet."
                AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding RasterFallbackAccepted, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="✓" FontWeight="Bold" MinWidth="16" TextAlignment="Center"
                       VerticalAlignment="Top" Margin="0,0,8,0"
                       Foreground="{StaticResource BorstWerk.Brush.Status.Info}" />
            <TextBlock Text="Visuelle Kopie wird verwendet" FontWeight="SemiBold"
                       VerticalAlignment="Top" Margin="0,0,8,0" />
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Top"
                       Text="Die Rechnungsdaten werden weiterhin aus dem Original gelesen." />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Abschnitt}" Text="Ergebnis der Prüfung"
                   Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Findings}"
                      AutomationProperties.Name="Befunde der Eingangsprüfung" />

        <!--
          Was aus dem PDF-Text gelesen werden konnte, mit den gelesenen Werten.
          Zeichen und Wort stehen nebeneinander, damit die Übersicht auch ohne
          Farbwahrnehmung vollständig lesbar bleibt.
        -->
        <TextBlock Style="{StaticResource Abschnitt}" Text="PDF analysiert"
                   Visibility="{Binding HasDetectionNotes, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding DetectionNotes}"
                      AutomationProperties.Name="Ergebnis der Datenerkennung">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <!--
                  Für die Sprachausgabe steht die Art als Wort davor. Ein
                  vorgelesenes „Fragezeichen“ sagt niemandem etwas.
                -->
                <AutomationProperties.Name>
                  <MultiBinding StringFormat="{}{0}: {1}">
                    <Binding Path="KindLabel" />
                    <Binding Path="Text" />
                  </MultiBinding>
                </AutomationProperties.Name>
                <TextBlock Text="{Binding Glyph}" FontWeight="Bold" MinWidth="16"
                           TextAlignment="Center" Margin="0,0,6,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Vorschau -->
    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
            Style="{StaticResource BorstWerk.Card.Muted}" Padding="0">
      <Grid>
        <TextBlock Text="Keine Vorschau verfügbar." HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource BorstWerk.Text.Hint}" />
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="6"
               AutomationProperties.Name="Vorschau der ersten Seite" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
