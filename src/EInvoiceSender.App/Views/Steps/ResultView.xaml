<UserControl x:Class="EInvoiceSender.App.Views.Steps.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EInvoiceSender.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResultViewModel}"
             d:DesignHeight="560" d:DesignWidth="960">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <!--
        Der Abschluss muss als solcher zu erkennen sein.

        Ohne diese Zeile endete der Ablauf wortlos: Der Anwender sah eine
        Dateiliste und eine abgeblendete Schaltfläche „Weiter“ und musste
        raten, ob noch etwas fehlt. Hier steht, dass es fertig ist.

        Zeichen, Wort und Farbe – in dieser Reihenfolge. Fiele die Farbe weg,
        bliebe die Aussage vollständig lesbar.
      -->
      <Border Style="{StaticResource BorstWerk.Status.Success}" Margin="0,0,0,16"
              AutomationProperties.Name="Fertig. Die E-Rechnung wurde erzeugt und geprüft."
              AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="✓" FontWeight="Bold" MinWidth="16" TextAlignment="Center"
                     VerticalAlignment="Top" Margin="0,0,8,0"
                     Foreground="{StaticResource BorstWerk.Brush.Status.Success}" />
          <TextBlock Text="Fertig" FontWeight="SemiBold" VerticalAlignment="Top"
                     Margin="0,0,8,0"
                     Foreground="{StaticResource BorstWerk.Brush.Status.Success}" />
          <TextBlock Text="Die E-Rechnung wurde erzeugt und geprüft."
                     TextWrapping="Wrap" VerticalAlignment="Top" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Abschnitt}" Text="Erzeugte Datei" Margin="0,0,0,4" />
      <UniformGrid Columns="2">
        <TextBlock Text="Dateiname" />
        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Speicherort" />
        <TextBlock Text="{Binding DirectoryPath}" TextWrapping="Wrap" />
        <TextBlock Text="Größe" />
        <TextBlock Text="{Binding FileSizeText}" />
        <TextBlock Text="Standard" />
        <TextBlock Text="{Binding StandardText}" TextWrapping="Wrap" />
        <TextBlock Text="Profil" />
        <TextBlock Text="{Binding ProfileText}" TextWrapping="Wrap" />
        <TextBlock Text="SHA-256" />
        <TextBox Text="{Binding Sha256Text, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                 AutomationProperties.Name="Prüfsumme der erzeugten Datei" />
      </UniformGrid>

      <!--
        Die Prüfwerkzeuge stehen einzeln da, jeweils mit dem Hinweis, ob sie
        gelaufen sind. Ein nicht ausgeführter Referenzvalidator darf nie wie
        ein bestandener aussehen.
      -->
      <TextBlock Style="{StaticResource Abschnitt}" Text="Verwendete Prüfwerkzeuge" />
      <ItemsControl ItemsSource="{Binding ValidatorLines}"
                    AutomationProperties.Name="Verwendete Prüfwerkzeuge">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource Abschnitt}" Text="Prüfbericht"
                 Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Findings}" AutomationProperties.Name="Prüfbericht" />

      <TextBlock Style="{StaticResource Abschnitt}" Text="E-Mail vorbereiten" />
      <UniformGrid Columns="2">
        <TextBlock Text="Empfänger" />
        <TextBox Text="{Binding EmailRecipient, UpdateSourceTrigger=PropertyChanged}" TabIndex="80"
                 AutomationProperties.Name="Empfänger der E-Mail" />
        <TextBlock Text="Betreff" />
        <TextBox Text="{Binding EmailSubject, UpdateSourceTrigger=PropertyChanged}" TabIndex="81"
                 AutomationProperties.Name="Betreff der E-Mail" />
      </UniformGrid>
      <TextBlock Text="Nachricht" Margin="0,8,0,0" />
      <TextBox Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}" TabIndex="82"
               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
               VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Nachrichtentext der E-Mail" />

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="E-Mail-Entwurf _öffnen" Command="{Binding CreateEmailDraftCommand}" TabIndex="83" />
        <Button Content="Ausgabe_ordner öffnen" Command="{Binding OpenOutputFolderCommand}" TabIndex="84" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
