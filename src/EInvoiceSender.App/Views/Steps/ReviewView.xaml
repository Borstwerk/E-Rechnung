<UserControl x:Class="EInvoiceSender.App.Views.Steps.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EInvoiceSender.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReviewViewModel}"
             d:DesignHeight="520" d:DesignWidth="960">

  <!--
    Der wichtigste Schritt: Links steht, was der Empfänger sieht, rechts das,
    was maschinell gelesen wird. Nur ein Mensch kann beurteilen, ob beides
    dasselbe aussagt.
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Margin="0,0,12,0"
            Style="{StaticResource BorstWerk.Card.Muted}" Padding="0">
      <Grid>
        <TextBlock Text="Keine Vorschau verfügbar." HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource BorstWerk.Text.Hint}" />
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="6"
               AutomationProperties.Name="Vorschau der PDF-Rechnung" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource Abschnitt}" Text="Erfasste Kerndaten" />
        <UniformGrid Columns="2">
          <TextBlock Text="Verkäufer" />
          <TextBlock Text="{Binding SellerText}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="Käufer" />
          <TextBlock Text="{Binding BuyerText}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="Rechnungsnummer" />
          <TextBlock Text="{Binding InvoiceNumberText}" FontWeight="SemiBold" />
          <TextBlock Text="Rechnungsdatum" />
          <TextBlock Text="{Binding IssueDateText}" FontWeight="SemiBold" />
          <TextBlock Text="Fällig am" />
          <TextBlock Text="{Binding DueDateText}" FontWeight="SemiBold" />
          <TextBlock Text="Netto" />
          <TextBlock Text="{Binding NetText}" FontWeight="SemiBold" />
          <TextBlock Text="Steuer" />
          <TextBlock Text="{Binding TaxText}" FontWeight="SemiBold" />
          <TextBlock Text="Brutto" />
          <TextBlock Text="{Binding GrossText}" FontWeight="SemiBold" />
          <TextBlock Text="Zahlbetrag" />
          <TextBlock Text="{Binding PayableText}" FontWeight="SemiBold" />
        </UniformGrid>

        <!--
          Abgleich mit dem aus der PDF gelesenen Betrag. Das ist ein zweites,
          unabhängiges Signal - keine rechtliche Wahrheit. Eine Abweichung
          blockiert deshalb nichts, sie weist nur hin.
        -->
        <Border Margin="0,16,0,0" Style="{StaticResource BorstWerk.Status.Base}"
                Visibility="{Binding HasTotalsComparison, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding TotalsComparisonGlyph}" FontWeight="Bold" MinWidth="16"
                       TextAlignment="Center" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding TotalsComparison.Message}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Abschnitt}" Text="Speicherort" />
        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" TabIndex="58"
                 AutomationProperties.Name="Ausgabeverzeichnis" />
        <Button Content="Ordner _wählen ..." Click="OnChooseFolderClicked" TabIndex="59"
                HorizontalAlignment="Left" Margin="0,6,0,0"
                AutomationProperties.HelpText="Wählt den Ordner, in den die E-Rechnung geschrieben wird." />

        <CheckBox IsChecked="{Binding ContentMatchConfirmed}" Margin="0,24,0,0" TabIndex="60"
                  AutomationProperties.Name="Bestätigung der Übereinstimmung">
          <TextBlock TextWrapping="Wrap"
                     Text="Ich habe geprüft, dass die strukturierten Rechnungsdaten mit der sichtbaren PDF-Rechnung übereinstimmen." />
        </CheckBox>

        <CheckBox IsChecked="{Binding ExistingInvoiceReplacementConfirmed}" TabIndex="61"
                  Visibility="{Binding ShowsReplacementQuestion, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="Bestätigung zum Ersetzen vorhandener Rechnungsdaten">
          <TextBlock TextWrapping="Wrap"
                     Foreground="{StaticResource BorstWerk.Brush.Status.Warning}"
                     Text="Diese PDF enthält bereits strukturierte Rechnungsdaten. Ich möchte sie durch die hier erfassten ersetzen." />
        </CheckBox>

        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,12,0,0"
                      AutomationProperties.Name="Hinweise zur Kontrollansicht" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
