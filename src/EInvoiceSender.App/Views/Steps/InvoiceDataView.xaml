<UserControl x:Class="EInvoiceSender.App.Views.Steps.InvoiceDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EInvoiceSender.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InvoiceDataViewModel}"
             d:DesignHeight="620" d:DesignWidth="960">

  <!--
    Aufbau dieser Ansicht:

    Jedes Feld bildet eine senkrechte Einheit aus Beschriftung, Eingabefeld
    und Herkunftshinweis. Vorher stand der Hinweis in einer eigenen Rasterzeile
    unter mehreren Feldern nebeneinander – er ließ sich dann keinem Feld mehr
    eindeutig zuordnen.

    Die Abstände kommen aus den Rändern der Zellen, nicht aus den
    Bedienelementen selbst. Deshalb tragen Eingabefelder hier nur einen kleinen
    oberen Rand.
  -->
  <UserControl.Resources>
    <Style x:Key="Feld" TargetType="TextBox">
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style x:Key="Auswahl" TargetType="ComboBox">
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style x:Key="Datumsfeld" TargetType="DatePicker">
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- Eine Feldeinheit im Dokumentraster: linke und mittlere Spalte. -->
    <Style x:Key="Rasterzelle" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,16,10" />
    </Style>

    <!-- Dieselbe Einheit in der rechten Spalte – ohne Abstand zum Rand. -->
    <Style x:Key="RasterzelleRechts" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <!--
        Was aus der PDF vorausgefüllt wurde. Dieser Hinweis steht bewusst nur
        hier: Die Statuszeile des Fensters meldet den Stand des Arbeitsablaufs,
        nicht dieselbe Zahl ein zweites Mal.
      -->
      <Border Style="{StaticResource BorstWerk.Status.Info}" Margin="0,0,0,8"
              Visibility="{Binding HasPrefillMessage, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="i" FontWeight="Bold" MinWidth="16" TextAlignment="Center" Margin="0,0,8,0"
                     Foreground="{StaticResource BorstWerk.Brush.Status.Info}" />
          <TextBlock Text="{Binding PrefillMessage}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>

      <!--
        Geänderte Verkäuferdaten aus den Einstellungen. Mitten im Vorgang wird
        nichts ausgetauscht, ohne zu fragen: Im Formular können längst eigene
        Angaben stehen.
      -->
      <Border Style="{StaticResource BorstWerk.Status.Warning}" Margin="0,0,0,8"
              Visibility="{Binding HasTemplateQuestion, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                     Text="Die Verkäuferdaten wurden geändert. Möchten Sie die neuen Angaben für diese Rechnung übernehmen? Rechnungsnummer, Käufer und Positionen bleiben in jedem Fall unverändert." />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Für diese Rechnung _übernehmen"
                    Command="{Binding ApplyChangedTemplateCommand}" TabIndex="5" MinWidth="220" />
            <Button Content="Erst bei neuer _Rechnung verwenden"
                    Command="{Binding KeepCurrentTemplateCommand}" TabIndex="6" MinWidth="240" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Dokument: drei gleich breite Spalten, je Feld eine Einheit. -->
      <TextBlock Style="{StaticResource Abschnitt}" Text="Dokument" Margin="0,0,0,4" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Rasterzelle}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Rechnungsnummer" />
          <TextBox Style="{StaticResource Feld}" TabIndex="10"
                   Text="{Binding Draft.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Rechnungsnummer" />
          <TextBlock Style="{StaticResource Herkunftshinweis}"
                     Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=InvoiceNumber}"
                     Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=InvoiceNumber}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Rasterzelle}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Rechnungsdatum" />
          <DatePicker Style="{StaticResource Datumsfeld}" TabIndex="11"
                      SelectedDate="{Binding Draft.IssueDate, Converter={StaticResource DateOnly}}"
                      AutomationProperties.Name="Rechnungsdatum" />
          <TextBlock Style="{StaticResource Herkunftshinweis}"
                     Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=IssueDate}"
                     Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=IssueDate}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource RasterzelleRechts}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Fällig am" />
          <DatePicker Style="{StaticResource Datumsfeld}" TabIndex="12"
                      SelectedDate="{Binding Draft.DueDate, Converter={StaticResource DateOnly}}"
                      AutomationProperties.Name="Fälligkeitsdatum" />
          <TextBlock Style="{StaticResource Herkunftshinweis}"
                     Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=DueDate}"
                     Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=DueDate}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Rasterzelle}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Währung" />
          <ComboBox Style="{StaticResource Auswahl}" TabIndex="13"
                    ItemsSource="{Binding Currencies}" DisplayMemberPath="Display"
                    SelectedValuePath="Code" SelectedValue="{Binding Draft.Currency}"
                    IsEditable="False" AutomationProperties.Name="Währung" />
          <TextBlock Style="{StaticResource Herkunftshinweis}"
                     Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=Currency}"
                     Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=Currency}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Rasterzelle}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Leistungsdatum" />
          <DatePicker Style="{StaticResource Datumsfeld}" TabIndex="14"
                      SelectedDate="{Binding Draft.DeliveryDate, Converter={StaticResource DateOnly}}"
                      AutomationProperties.Name="Leistungsdatum" />
          <TextBlock Style="{StaticResource Herkunftshinweis}"
                     Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=DeliveryDate}"
                     Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=DeliveryDate}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource RasterzelleRechts}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Zahlungsbedingungen" />
          <TextBox Style="{StaticResource Feld}" TabIndex="15"
                   Text="{Binding Draft.PaymentTerms, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Zahlungsbedingungen" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource Rasterzelle}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Leistungszeitraum von" />
          <DatePicker Style="{StaticResource Datumsfeld}" TabIndex="16"
                      SelectedDate="{Binding Draft.BillingPeriodStart, Converter={StaticResource DateOnly}}"
                      AutomationProperties.Name="Beginn des Leistungszeitraums" />
          <TextBlock Style="{StaticResource Herkunftshinweis}"
                     Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BillingPeriodStart}"
                     Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BillingPeriodStart}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource Rasterzelle}">
          <TextBlock Style="{StaticResource Feldbeschriftung}" Text="Leistungszeitraum bis" />
          <DatePicker Style="{StaticResource Datumsfeld}" TabIndex="17"
                      SelectedDate="{Binding Draft.BillingPeriodEnd, Converter={StaticResource DateOnly}}"
                      AutomationProperties.Name="Ende des Leistungszeitraums" />
          <TextBlock Style="{StaticResource Herkunftshinweis}"
                     Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BillingPeriodEnd}"
                     Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BillingPeriodEnd}" />
        </StackPanel>
      </Grid>

      <!--
        Verkäufer und Käufer als zwei gleich breite Karten nebeneinander.
        Innerhalb einer Karte trägt ein gewöhnliches Raster die Felder: die
        Beschriftung links, das Eingabefeld rechts, der Herkunftshinweis
        unmittelbar darunter in derselben Spalte. PLZ und Ort teilen sich eine
        Zeile, weil sie zusammen gelesen werden.
      -->
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource BorstWerk.Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Abschnitt}" Text="Verkäufer (Sie)" Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!-- Je Feld eine Zeile, darunter je eine Zeile für den Herkunftshinweis. -->
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Name" Margin="0,0,8,0" />
              <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="20"
                       Text="{Binding Draft.SellerName, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Name des Rechnungsstellers" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerName}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerName}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Straße" Margin="0,6,8,0" />
              <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="21" Margin="0,6,0,0"
                       Text="{Binding Draft.SellerStreet, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Straße des Rechnungsstellers" />
              <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerStreet}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerStreet}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="PLZ" Margin="0,6,8,0" />
              <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Feld}" TabIndex="22"
                       Margin="0,6,12,0" MinWidth="70"
                       Text="{Binding Draft.SellerPostalCode, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Postleitzahl des Rechnungsstellers" />
              <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Feldbeschriftung}"
                         Text="Ort" Margin="0,6,8,0" />
              <TextBox Grid.Row="4" Grid.Column="3" Style="{StaticResource Feld}" TabIndex="23"
                       Margin="0,6,0,0"
                       Text="{Binding Draft.SellerCity, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Ort des Rechnungsstellers" />
              <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Herkunftshinweis}"
                         Margin="0,1,12,0"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerPostalCode}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerPostalCode}" />
              <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerCity}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerCity}" />

              <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Land" Margin="0,6,8,0" />
              <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                        Style="{StaticResource Auswahl}" TabIndex="24" Margin="0,6,0,0"
                        ItemsSource="{Binding Countries}"
                        DisplayMemberPath="Display" SelectedValuePath="Code"
                        SelectedValue="{Binding Draft.SellerCountry}"
                        AutomationProperties.Name="Land des Rechnungsstellers" />
              <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerCountry}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerCountry}" />

              <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="USt-IdNr." Margin="0,6,8,0" />
              <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="25" Margin="0,6,0,0"
                       Text="{Binding Draft.SellerVatId, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Umsatzsteuer-Identifikationsnummer" />
              <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerVatId}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerVatId}" />

              <!--
                Die Steuernummer stand bisher nur in den Einstellungen. Die
                Erkennung füllt sie aber ebenfalls, und in die erzeugte
                Rechnung geht sie auch – ohne Feld liefe sie unbestätigt durch.
              -->
              <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Steuernummer" Margin="0,6,8,0" />
              <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="26" Margin="0,6,0,0"
                       Text="{Binding Draft.SellerTaxNumber, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Steuernummer des Rechnungsstellers" />
              <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerTaxNumber}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerTaxNumber}" />

              <!--
                Registerkennung (BT-30) und Verkäuferkennung (BT-29) stehen
                unmittelbar hinter den steuerlichen Angaben, weil sie dieselbe
                Frage beantworten: Woran erkennt der Empfänger den
                Rechnungssteller? Nach BR-CO-26 genügt eine der drei – die
                Steuernummer allein gehört ausdrücklich nicht dazu.
              -->
              <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Registerkennung" Margin="0,6,8,0" />
              <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="27" Margin="0,6,0,0"
                       Text="{Binding Draft.SellerLegalRegistrationId, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Registerkennung des Rechnungsstellers, zum Beispiel die Handelsregisternummer" />
              <TextBlock Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerLegalRegistrationId}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerLegalRegistrationId}" />

              <!--
                Die Lieferantennummer vergibt der Kunde. Sie steht deshalb nur
                hier und nicht in den Einstellungen: Beim nächsten Kunden ist
                es eine andere.
              -->
              <TextBlock Grid.Row="14" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Lieferantennummer" Margin="0,6,8,0" />
              <TextBox Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="28" Margin="0,6,0,0"
                       Text="{Binding Draft.SellerIdentifier, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Nur verwenden, wenn Ihr Käufer Ihnen eine Lieferanten- oder Kreditorennummer mitgeteilt hat – also die Nummer, unter der er Sie in seiner Buchhaltung führt. Eine selbst vergebene Nummer gehört nicht hierher; lassen Sie das Feld dann leer."
                       AutomationProperties.Name="Lieferanten- oder Kreditorennummer, die Ihr Kunde Ihnen zugeteilt hat" />
              <TextBlock Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerIdentifier}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerIdentifier}" />

              <TextBlock Grid.Row="16" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="E-Mail" Margin="0,6,8,0" />
              <TextBox Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="29" Margin="0,6,0,0"
                       Text="{Binding Draft.SellerEmail, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="E-Mail des Rechnungsstellers" />
              <TextBlock Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=SellerEmail}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=SellerEmail}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource BorstWerk.Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Abschnitt}" Text="Käufer (Empfänger)" Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Name" Margin="0,0,8,0" />
              <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="30"
                       Text="{Binding Draft.BuyerName, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Name des Rechnungsempfängers" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BuyerName}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BuyerName}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Straße" Margin="0,6,8,0" />
              <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="31" Margin="0,6,0,0"
                       Text="{Binding Draft.BuyerStreet, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Straße des Rechnungsempfängers" />
              <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BuyerStreet}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BuyerStreet}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="PLZ" Margin="0,6,8,0" />
              <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Feld}" TabIndex="32"
                       Margin="0,6,12,0" MinWidth="70"
                       Text="{Binding Draft.BuyerPostalCode, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Postleitzahl des Rechnungsempfängers" />
              <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Feldbeschriftung}"
                         Text="Ort" Margin="0,6,8,0" />
              <TextBox Grid.Row="4" Grid.Column="3" Style="{StaticResource Feld}" TabIndex="33"
                       Margin="0,6,0,0"
                       Text="{Binding Draft.BuyerCity, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Ort des Rechnungsempfängers" />
              <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Herkunftshinweis}"
                         Margin="0,1,12,0"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BuyerPostalCode}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BuyerPostalCode}" />
              <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BuyerCity}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BuyerCity}" />

              <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="Land" Margin="0,6,8,0" />
              <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                        Style="{StaticResource Auswahl}" TabIndex="34" Margin="0,6,0,0"
                        ItemsSource="{Binding Countries}"
                        DisplayMemberPath="Display" SelectedValuePath="Code"
                        SelectedValue="{Binding Draft.BuyerCountry}"
                        AutomationProperties.Name="Land des Rechnungsempfängers" />
              <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BuyerCountry}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BuyerCountry}" />

              <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="USt-IdNr." Margin="0,6,8,0" />
              <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="35" Margin="0,6,0,0"
                       Text="{Binding Draft.BuyerVatId, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Umsatzsteuer-Identifikationsnummer des Empfängers" />
              <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BuyerVatId}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BuyerVatId}" />

              <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                         Text="E-Mail" Margin="0,6,8,0" />
              <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Feld}" TabIndex="36" Margin="0,6,0,0"
                       Text="{Binding Draft.BuyerEmail, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="E-Mail des Rechnungsempfängers" />
              <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource Herkunftshinweis}"
                         Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BuyerEmail}"
                         Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BuyerEmail}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!--
        Bankverbindung. Bewusst schmal gehalten und linksbündig: Über die volle
        Fensterbreite gezogen wirkten die drei Felder verloren.
      -->
      <TextBlock Style="{StaticResource Abschnitt}" Text="Bankverbindung" />
      <Grid HorizontalAlignment="Left" MinWidth="420" MaxWidth="560">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                   Text="Kontoinhaber" Margin="0,0,8,0" />
        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Feld}" TabIndex="40"
                 Text="{Binding Draft.BankAccountHolder, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Kontoinhaber" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                   Text="IBAN" Margin="0,6,8,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Feld}" TabIndex="41"
                 Margin="0,6,0,0"
                 Text="{Binding Draft.BankIban, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="IBAN" />
        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Herkunftshinweis}"
                   Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BankIban}"
                   Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BankIban}" />

        <!-- Die Freiwilligkeit steht in der Beschriftung, nicht als Zusatzzeile. -->
        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Feldbeschriftung}"
                   Text="BIC (freiwillig)" Margin="0,6,8,0" />
        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Feld}" TabIndex="42"
                 Margin="0,6,0,0"
                 Text="{Binding Draft.BankBic, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="BIC (freiwillige Angabe)" />
        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Herkunftshinweis}"
                   Text="{Binding Draft.Origins, Converter={StaticResource FieldOrigin}, ConverterParameter=BankBic}"
                   Visibility="{Binding Draft.Origins, Converter={StaticResource FieldOriginVisible}, ConverterParameter=BankBic}" />
      </Grid>

      <!--
        Ausschließlich eine ausdrückliche Aktion speichert Unternehmensdaten.
        Der Speicherplaner übernimmt von Hand bearbeitete Allowlist-Felder und
        unveränderte Werte des konkreten Seller-Proposals. Käuferdaten und
        beliebige andere PDF-Werte gelangen nicht in die Vorlage.
      -->
      <Border Style="{StaticResource BorstWerk.Status.Info}" Margin="0,12,0,8"
              Visibility="{Binding ShowsCompanyTemplateSaveOffer, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Eigene Unternehmensdaten" />
          <TextBlock Margin="0,3,0,8" TextWrapping="Wrap"
                     Text="{Binding CompanyTemplateSaveOfferText}" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Als _meine Unternehmensdaten speichern"
                    Command="{Binding SaveOwnCompanyDataCommand}"
                    HorizontalAlignment="Left" MinWidth="290" TabIndex="45"
                    AutomationProperties.Name="Als meine Unternehmensdaten speichern" />
            <Button Content="_Nicht als eigene Daten speichern"
                    Command="{Binding DismissOwnCompanyProposalCommand}"
                    Visibility="{Binding HasOwnCompanyProposal, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left" MinWidth="240" TabIndex="46"
                    AutomationProperties.Name="Nicht als eigene Daten speichern" />
          </StackPanel>

          <Border Style="{StaticResource BorstWerk.Status.Warning}" Margin="0,10,0,0"
                  Visibility="{Binding HasCompanyTemplateOverwriteQuestion, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                         Text="Eine Firmenvorlage ist bereits gespeichert. Möchten Sie deren Unternehmensdaten mit den ausdrücklich bestätigten Angaben aktualisieren? Nicht geänderte Firmenangaben und alle Komfortvorgaben bleiben erhalten." />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Vorlage _aktualisieren"
                        Command="{Binding ConfirmCompanyTemplateOverwriteCommand}"
                        MinWidth="180" TabIndex="47" />
                <Button Content="_Abbrechen"
                        Command="{Binding CancelCompanyTemplateOverwriteCommand}"
                        MinWidth="120" TabIndex="48" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="{Binding CompanyTemplateSaveMessage}"
                     Visibility="{Binding HasCompanyTemplateSaveMessage, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>

      <!-- Positionen -->
      <TextBlock Style="{StaticResource Abschnitt}" Text="Positionen" />
      <DataGrid x:Name="Positionen"
                ItemsSource="{Binding Draft.Lines}" SelectedItem="{Binding SelectedLine}"
                AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                MinHeight="150" MaxHeight="260" TabIndex="50"
                AutomationProperties.Name="Rechnungspositionen">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nr." Binding="{Binding Number}" IsReadOnly="True" Width="46" />
          <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="*" />
          <!--
            Die Beschreibung (BT-154) geht in die E-Rechnung; die Erkennung
            füllt sie aus Fortsetzungszeilen. Ohne Spalte stünde damit ein Wert
            in der Rechnung, den niemand gesehen und bestätigt hat.
          -->
          <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*" />
          <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="80" />
          <DataGridComboBoxColumn Header="Einheit" Width="130"
                                  SelectedValueBinding="{Binding Unit}"
                                  DisplayMemberPath="Display" SelectedValuePath="Code"
                                  ItemsSource="{x:Static vm:InvoiceDataViewModel.Units}" />
          <DataGridTextColumn Header="Einzelpreis" Binding="{Binding NetUnitPrice}" Width="110" />
          <DataGridTextColumn Header="Steuersatz %" Binding="{Binding VatRate}" Width="100" />
          <DataGridComboBoxColumn Header="Steuerkategorie" Width="200"
                                  SelectedValueBinding="{Binding VatCategory}"
                                  DisplayMemberPath="Display" SelectedValuePath="Category"
                                  ItemsSource="{x:Static vm:InvoiceDataViewModel.VatCategories}" />
        </DataGrid.Columns>
      </DataGrid>

      <!--
        Schaltflächen und Summen teilen sich eine Zeile: Die Summen gehören
        unmittelbar unter die Positionstabelle, an deren rechten Rand – dort
        sucht sie jeder, der eine Rechnung liest.
      -->
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
          <!--
            Click schließt eine offene Zellenbearbeitung ab, bevor der Befehl
            läuft. WPF löst Click vor dem Command aus – siehe
            InvoiceDataView.xaml.cs.
          -->
          <Button Content="Position _hinzufügen" Command="{Binding AddLineCommand}" TabIndex="51"
                  Click="OnLineActionClicked" />
          <Button Content="Position _entfernen" Command="{Binding RemoveLineCommand}" TabIndex="52"
                  Click="OnLineActionClicked" />
          <Button Content="Summen _neu berechnen" Command="{Binding RecalculateTotalsCommand}" TabIndex="53"
                  Click="OnLineActionClicked" />
        </StackPanel>

        <Grid Grid.Column="1" AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Berechnete Summen">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Betragsbeschriftung}" Text="Netto" />
          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Betrag}"
                     Text="{Binding Totals.TaxBasisTotal, StringFormat=N2}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Betragsbeschriftung}" Text="Steuer" />
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Betrag}"
                     Text="{Binding Totals.TaxTotal, StringFormat=N2}" />

          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,4"
                  BorderBrush="{StaticResource BorstWerk.Brush.Border}" BorderThickness="0,1,0,0" />

          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Betragsbeschriftung}"
                     Text="Brutto" FontWeight="SemiBold" />
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Betrag}"
                     Text="{Binding Totals.GrandTotal, StringFormat=N2}" FontWeight="SemiBold" />

          <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Betragsbeschriftung}"
                     Text="Zahlbetrag" FontWeight="Bold" FontSize="14" />
          <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Betrag}"
                     Text="{Binding Totals.DuePayableAmount, StringFormat=N2}"
                     FontWeight="Bold" FontSize="14" />
        </Grid>
      </Grid>

      <!-- Befunde -->
      <TextBlock Style="{StaticResource Abschnitt}" Text="Prüfergebnis"
                 Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Findings}"
                    AutomationProperties.Name="Befunde der Datenprüfung" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
