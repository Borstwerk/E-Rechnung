<Window x:Class="EInvoiceSender.App.Views.Dialogs.EInvoiceCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EInvoiceSender.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EInvoiceCheckViewModel}"
        Title="E-Rechnung prüfen – BorstWerk E-Rechnung"
        Icon="/Assets/BorstWerkEInvoice.ico"
        Background="{StaticResource BorstWerk.Brush.Background}"
        Height="780" Width="1000"
        MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="E-Rechnung prüfen"
               Style="{StaticResource BorstWerk.Text.PageTitle}" />

    <Border Grid.Row="1" Style="{StaticResource BorstWerk.Status.Info}" Margin="0,12,0,0"
            AutomationProperties.Name="Grenzen der technischen Bestandsaufnahme">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="i" FontWeight="Bold" MinWidth="16" TextAlignment="Center"
                   VerticalAlignment="Top" Margin="0,0,8,0"
                   Foreground="{StaticResource BorstWerk.Brush.Status.Info}" />
        <TextBlock TextWrapping="Wrap"
                   Text="Die Datei wird ausschließlich gelesen und nicht verändert. Diese technische Bestandsaufnahme ist keine vollständige EN-16931- oder PDF/A-Konformitätsprüfung." />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="E-Rechnung _auswählen ..." Click="OnSelectClicked" TabIndex="1"
              IsEnabled="{Binding IsIdle}"
              AutomationProperties.HelpText="Öffnet eine vorhandene PDF-Hybridrechnung ausschließlich zum Lesen." />
      <TextBlock Grid.Column="1" Text="{Binding SelectedFileName}" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" Margin="12,0" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="2" Width="100" Height="6" Margin="16,0,0,0"
                   IsIndeterminate="True"
                   Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.Name="Technische Bestandsaufnahme läuft" />
      <Button Grid.Column="3" Content="_Abbrechen" Command="{Binding InspectCancelCommand}" TabIndex="2"
              Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <TextBlock Grid.Row="3" Text="{Binding SummaryText}" TextWrapping="Wrap"
               Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />

    <ScrollViewer Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource BorstWerk.Card.Muted}"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Datei"
                       Style="{StaticResource BorstWerk.Text.CardTitle}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="Name" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Result.SourceFileName}" />
            <TextBlock Grid.Row="2" Text="Größe" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding Result.SourceSizeInBytes, StringFormat={}{0:N0} Bytes}" />
            <TextBlock Grid.Row="3" Text="SHA-256" FontWeight="SemiBold" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Result.SourceSha256}"
                       FontFamily="Consolas" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border Style="{StaticResource BorstWerk.Card.Muted}" Margin="0,12,0,0"
                Visibility="{Binding HasDocumentInfo, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="Technische Dokumentangaben"
                       Style="{StaticResource BorstWerk.Text.CardTitle}" Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="PDF-Version" FontWeight="SemiBold" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Result.DocumentInfo.PdfVersion}" />
              <TextBlock Grid.Row="1" Text="Seiten" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Result.DocumentInfo.PageCount}" />
              <TextBlock Grid.Row="2" Text="PDF/A-Deklaration" FontWeight="SemiBold" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="PDF/A-" />
                <TextBlock Text="{Binding Result.DocumentInfo.DeclaredPdfAPart, TargetNullValue=–}" />
                <TextBlock Text="{Binding Result.DocumentInfo.DeclaredPdfAConformance}" />
              </StackPanel>
              <TextBlock Grid.Row="3" Text="Rechnungsanhang" FontWeight="SemiBold" />
              <TextBlock Grid.Row="3" Grid.Column="1"
                         Text="{Binding Result.DocumentInfo.InvoiceAttachmentName, TargetNullValue=–}" />
              <TextBlock Grid.Row="4" Text="Anhangsformat" FontWeight="SemiBold" />
              <TextBlock Grid.Row="4" Grid.Column="1"
                         Text="{Binding Result.DocumentInfo.InvoiceAttachmentKind, TargetNullValue=–}" />
              <TextBlock Grid.Row="5" Text="Anhangsgröße" FontWeight="SemiBold" />
              <TextBlock Grid.Row="5" Grid.Column="1"
                         Text="{Binding Result.DocumentInfo.InvoiceAttachmentSizeInBytes, StringFormat={}{0:N0} Bytes, TargetNullValue=–}" />
              <TextBlock Grid.Row="6" Text="Profilkennung" FontWeight="SemiBold" />
              <TextBlock Grid.Row="6" Grid.Column="1"
                         Text="{Binding Result.DocumentInfo.ProfileId, TargetNullValue=–}"
                         TextWrapping="Wrap" />
            </Grid>

            <TextBlock Style="{StaticResource Abschnitt}" Text="Eingebettete Dateien"
                       Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding Result.DocumentInfo.EmbeddedFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding FileName}" FontWeight="SemiBold" />
                    <Run Text=" – " />
                    <Run Text="{Binding MimeType, TargetNullValue=unbekannter Typ}" />
                    <Run Text=", " />
                    <Run Text="{Binding SizeInBytes, StringFormat={}{0:N0} Bytes}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource BorstWerk.Card.Muted}" Margin="0,12,0,0"
                Visibility="{Binding HasInvoiceSummary, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="Gelesene Rechnungsdaten"
                       Style="{StaticResource BorstWerk.Text.CardTitle}" Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Rechnungsnummer" FontWeight="SemiBold" />
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Text="{Binding Result.InvoiceSummary.InvoiceNumber, TargetNullValue=–}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Rechnungsdatum" FontWeight="SemiBold" />
              <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding IssueDateText}" />

              <TextBlock Grid.Row="1" Text="Rechnungsart" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="1"
                         Text="{Binding Result.InvoiceSummary.TypeCode, TargetNullValue=–}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Währung" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="3"
                         Text="{Binding Result.InvoiceSummary.Currency, TargetNullValue=–}" />

              <TextBlock Grid.Row="2" Text="Verkäuferkennung" FontWeight="SemiBold" />
              <TextBlock Grid.Row="2" Grid.Column="1"
                         Text="{Binding Result.InvoiceSummary.SellerIdentifier, TargetNullValue=–}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Positionen" FontWeight="SemiBold" />
              <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Result.InvoiceSummary.LineCount}" />

              <TextBlock Grid.Row="3" Text="Positionssumme" FontWeight="SemiBold" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LineTotalText}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Text="Nettosumme" FontWeight="SemiBold" />
              <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding TaxBasisTotalText}" />

              <TextBlock Grid.Row="4" Text="Gesamtsteuer" FontWeight="SemiBold" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TaxTotalText}" />
              <TextBlock Grid.Row="4" Grid.Column="2" Text="Bruttosumme" FontWeight="SemiBold" />
              <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding GrandTotalText}" />

              <TextBlock Grid.Row="5" Text="Offener Zahlbetrag" FontWeight="SemiBold" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DuePayableAmountText}" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Abschnitt}" Text="Befunde"
                   Margin="0,14,0,4"
                   Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Findings}"
                      AutomationProperties.Name="Befunde der technischen Bestandsaufnahme" />
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="5" Content="_Schließen" IsCancel="True" TabIndex="3"
            HorizontalAlignment="Right" Margin="0,14,0,0" />
  </Grid>
</Window>
