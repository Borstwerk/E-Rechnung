<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF-Oberflaeche (MVVM). Enthaelt keine Geschaeftslogik.
    Verdrahtet die Ports der Application-Schicht mit den Adaptern
    aus Infrastructure / Formats / Validation / Mail.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EInvoiceSender.Desktop</RootNamespace>
    <AssemblyName>EInvoiceSender</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EInvoiceSender.Domain\EInvoiceSender.Domain.csproj" />
    <ProjectReference Include="..\EInvoiceSender.Application\EInvoiceSender.Application.csproj" />
    <ProjectReference Include="..\EInvoiceSender.Formats\EInvoiceSender.Formats.csproj" />
    <ProjectReference Include="..\EInvoiceSender.Validation\EInvoiceSender.Validation.csproj" />
    <ProjectReference Include="..\EInvoiceSender.Infrastructure\EInvoiceSender.Infrastructure.csproj" />
    <ProjectReference Include="..\EInvoiceSender.Mail\EInvoiceSender.Mail.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="PDFtoImage" />
  </ItemGroup>

</Project>
