<Application x:Class="EInvoiceSender.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!--
      Bewusst nuechtern gehalten: Der Arbeitsablauf hat Vorrang vor der
      Gestaltung. Wichtig sind lesbare Schriftgroessen, sichtbarer Fokus und
      ausreichend grosse Bedienflaechen.
    -->
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4,8,4" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinWidth" Value="110" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,6,0,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Ueberschrift" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Abschnitt" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,4" />
    </Style>
  </Application.Resources>
</Application>
