<Window x:Class="EInvoiceSender.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EInvoiceSender – E-Rechnung erstellen"
        Height="820" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnFileDropped"
        DragOver="OnDragOver">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Kopfzeile mit Schrittangabe -->
    <TextBlock Grid.Row="0" Text="{Binding StepTitle}" Style="{StaticResource Ueberschrift}"
               AutomationProperties.LiveSetting="Polite" />

    <!-- Inhalt je Schritt -->
    <Grid Grid.Row="1">
      <!-- Schritt 1: PDF auswaehlen -->
      <StackPanel x:Name="SchrittPdf" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap"
                   Text="Ziehen Sie Ihre fertige PDF-Rechnung in dieses Fenster oder waehlen Sie sie aus. Die Datei wird nur gelesen und niemals veraendert." />
        <Button Content="PDF-Rechnung auswaehlen ..." Click="OnSelectPdfClicked"
                HorizontalAlignment="Left" Margin="0,12,0,0"
                AutomationProperties.HelpText="Oeffnet einen Dateidialog zur Auswahl der PDF-Rechnung." />

        <TextBlock Style="{StaticResource Abschnitt}" Text="Ergebnis der Pruefung" />
        <ItemsControl x:Name="PreflightListe" ItemsSource="{Binding Findings}" />
      </StackPanel>

      <!-- Schritt 2: Rechnungsdaten -->
      <ScrollViewer x:Name="SchrittDaten" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Abschnitt}" Text="Dokument" />
          <UniformGrid Columns="4">
            <TextBlock Text="Rechnungsnummer" />
            <TextBox Text="{Binding Draft.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Rechnungsnummer" />
            <TextBlock Text="Waehrung" />
            <TextBox Text="{Binding Draft.Currency, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Waehrung" />
          </UniformGrid>

          <TextBlock Style="{StaticResource Abschnitt}" Text="Verkaeufer" />
          <UniformGrid Columns="4">
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Draft.SellerName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Name des Rechnungsstellers" />
            <TextBlock Text="USt-IdNr." />
            <TextBox Text="{Binding Draft.SellerVatId, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Umsatzsteuer-Identifikationsnummer" />
            <TextBlock Text="Strasse" />
            <TextBox Text="{Binding Draft.SellerStreet, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Strasse des Rechnungsstellers" />
            <TextBlock Text="PLZ und Ort" />
            <TextBox Text="{Binding Draft.SellerCity, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Ort des Rechnungsstellers" />
            <TextBlock Text="IBAN" />
            <TextBox Text="{Binding Draft.BankIban, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="IBAN" />
          </UniformGrid>

          <TextBlock Style="{StaticResource Abschnitt}" Text="Kaeufer" />
          <UniformGrid Columns="4">
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Draft.BuyerName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Name des Rechnungsempfaengers" />
            <TextBlock Text="E-Mail" />
            <TextBox Text="{Binding Draft.BuyerEmail, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="E-Mail des Rechnungsempfaengers" />
            <TextBlock Text="Strasse" />
            <TextBox Text="{Binding Draft.BuyerStreet, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Strasse des Rechnungsempfaengers" />
            <TextBlock Text="PLZ und Ort" />
            <TextBox Text="{Binding Draft.BuyerCity, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Ort des Rechnungsempfaengers" />
          </UniformGrid>

          <TextBlock Style="{StaticResource Abschnitt}" Text="Positionen" />
          <DataGrid ItemsSource="{Binding Draft.Lines}" AutoGenerateColumns="False"
                    CanUserAddRows="False" HeadersVisibility="Column" MinHeight="160"
                    AutomationProperties.Name="Rechnungspositionen">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nr." Binding="{Binding Number}" IsReadOnly="True" Width="46" />
              <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="80" />
              <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="80" />
              <DataGridTextColumn Header="Einzelpreis" Binding="{Binding NetUnitPrice}" Width="110" />
              <DataGridTextColumn Header="Steuersatz" Binding="{Binding VatRate}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
          <Button Content="Position hinzufuegen" Click="OnAddLineClicked"
                  HorizontalAlignment="Left" Margin="0,8,0,0" />

          <TextBlock Style="{StaticResource Abschnitt}" Text="Berechnete Summen" />
          <TextBlock x:Name="SummenAnzeige" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />

          <TextBlock Style="{StaticResource Abschnitt}" Text="Pruefergebnis" />
          <ItemsControl ItemsSource="{Binding Findings}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Schritt 3: Kontrollansicht -->
      <Grid x:Name="SchrittKontrolle" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0">
          <Image x:Name="PdfVorschau" Stretch="Uniform"
                 AutomationProperties.Name="Vorschau der PDF-Rechnung" />
        </Border>

        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource Abschnitt}" Text="Erfasste Kerndaten" />
          <TextBlock x:Name="KontrollAnzeige" TextWrapping="Wrap" />

          <CheckBox IsChecked="{Binding ContentMatchConfirmed}" Margin="0,20,0,0"
                    AutomationProperties.Name="Bestaetigung der Uebereinstimmung">
            <TextBlock TextWrapping="Wrap"
                       Text="Ich habe geprueft, dass die strukturierten Rechnungsdaten mit der sichtbaren PDF-Rechnung uebereinstimmen." />
          </CheckBox>
        </StackPanel>
      </Grid>

      <!-- Schritt 4: Erzeugen -->
      <StackPanel x:Name="SchrittErzeugen" Visibility="Collapsed">
        <TextBlock Text="Die E-Rechnung wird erzeugt und geprueft." TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Progress}" Margin="0,12,0,0"
                      AutomationProperties.Name="Fortschritt der Erzeugung">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Text="{Binding StateLabel}" Width="180" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Abschnitt}" Text="Meldungen" />
        <ItemsControl ItemsSource="{Binding Findings}" />
      </StackPanel>

      <!-- Schritt 5: Abschluss -->
      <ScrollViewer x:Name="SchrittAbschluss" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="ErgebnisAnzeige" TextWrapping="Wrap" />

          <TextBlock Style="{StaticResource Abschnitt}" Text="E-Mail vorbereiten" />
          <UniformGrid Columns="2">
            <TextBlock Text="Empfaenger" />
            <TextBox Text="{Binding EmailRecipient, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Empfaenger der E-Mail" />
            <TextBlock Text="Betreff" />
            <TextBox Text="{Binding EmailSubject, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Betreff der E-Mail" />
          </UniformGrid>
          <TextBox Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" Margin="0,8,0,0"
                   VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="Nachrichtentext" />

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="E-Mail-Entwurf oeffnen" Click="OnCreateDraftClicked" />
            <Button Content="Ausgabeordner oeffnen" Click="OnOpenFolderClicked" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Statuszeile -->
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
               Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />

    <!-- Navigation -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Zurueck" Command="{Binding GoBackCommand}" />
      <Button Content="Weiter" Command="{Binding GoForwardCommand}" IsDefault="True" />
      <Button Content="Erzeugen" Command="{Binding GenerateCommand}" />
      <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>
