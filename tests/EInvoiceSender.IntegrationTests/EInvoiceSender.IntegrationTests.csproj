<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integrationstests: kompletter Weg von der Eingabe-PDF bis zur validierten
    ZUGFeRD-Datei und zum E-Mail-Entwurf, einschliesslich der Gegenpruefung
    durch die externen Referenzwerkzeuge.

    Der Verweis auf EInvoiceSender.Core.Tests dient allein den gemeinsamen
    Testvorgaben (InvoiceScenarios, TestPdfFactory). Beide Testprojekte
    zusammen ersetzen die frueheren sechs.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EInvoiceSender.IntegrationTests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EInvoiceSender.Core\EInvoiceSender.Core.csproj" />
    <ProjectReference Include="..\EInvoiceSender.Core.Tests\EInvoiceSender.Core.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
