<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit-Tests des Kerns: Werttypen, Berechnung, Regelprüfung, Codelisten,
    CII-Writer und -Reader, Golden Master, E-Mail-Entwurf, Dateinamen.

    Enthält außerdem die quelltextbasierten Prüfungen der Oberfläche
    (Ordner App). Diese lesen die Dateien von EInvoiceSender.App als Text und
    brauchen deshalb kein WPF und keinen Windows-Rechner.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EInvoiceSender.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EInvoiceSender.Core\EInvoiceSender.Core.csproj" />
  </ItemGroup>

  <!--
    Diese reine Präsentationshilfe hat keine WPF-Abhängigkeit. Sie wird hier
    als dieselbe Quelldatei mitübersetzt, damit deutsche Datums-/Geldformate
    auch im plattformneutralen Linux-Testlauf wirklich ausgeführt werden.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\EInvoiceSender.App\Presentation\EInvoiceCheckDisplayFormatter.cs"
             Link="App\EInvoiceCheckDisplayFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
