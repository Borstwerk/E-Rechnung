<?xml version="1.0" encoding="UTF-8"?>
<!--
  Installationspaket für EInvoiceSender.

  Festlegungen und ihre Gründe:

  * Scope="perUser" – die Installation braucht keine Administratorrechte.
    Das ist für Einzelunternehmer und kleine Betriebe die deutlich
    unkompliziertere Variante, und die Anwendung schreibt ohnehin nur in das
    Benutzerprofil.
  * UpgradeCode bleibt über alle Versionen unverändert. Nur so erkennt
    Windows eine spätere Fassung als Aktualisierung statt als zweite
    Installation.
  * MajorUpgrade mit AllowSameVersionUpgrades: eine neuere Fassung ersetzt die
    alte, eine ältere wird mit verständlicher Meldung abgelehnt.
  * Die Id-Attribute bleiben in ASCII geschrieben. Sie sind Kennungen,
    keine angezeigten Texte, und werden in dieser Datei gegenseitig
    referenziert. Angezeigt werden Title, Description und Name - dort stehen
    Umlaute.
  * Benutzerdaten unter %LOCALAPPDATA%\EInvoiceSender werden bei der
    Deinstallation NICHT entfernt. Vorlage, Einstellungen und Protokolle
    gehören dem Benutzer; sie ungefragt zu löschen wäre übergriffig.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="$(ProductName)"
           Manufacturer="$(ProductManufacturer)"
           Version="$(ProductVersion)"
           UpgradeCode="7f3c1d92-4b6a-4d21-9d0e-2a5c8b1e7f40"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="Elektronische Rechnungen aus vorhandenen PDF-Rechnungen erstellen" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="Es ist bereits eine neuere Fassung von $(ProductName) installiert. Bitte deinstallieren Sie diese zuerst, wenn Sie eine ältere Fassung einsetzen möchten." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Lizenzhinweise der Drittkomponenten, im Installationsdialog sichtbar -->
    <WixVariable Id="WixUILicenseRtf" Value="Lizenzhinweise.rtf" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="Hauptfunktion" Title="$(ProductName)" Level="1"
             Description="Die Anwendung und alle benötigten Bestandteile.">
      <ComponentGroupRef Id="AnwendungsDateien" />
      <ComponentRef Id="StartmenuVerknuepfung" />
    </Feature>

    <Feature Id="Desktopverknuepfung" Title="Verknüpfung auf dem Desktop" Level="2"
             Description="Legt zusätzlich eine Verknüpfung auf dem Desktop an.">
      <ComponentRef Id="DesktopVerknuepfung" />
    </Feature>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="HerstellerOrdner" Name="$(ProductManufacturer)">
        <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartmenuOrdner" Name="$(ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Startmenüeintrag -->
    <Component Id="StartmenuVerknuepfung" Directory="StartmenuOrdner" Guid="*">
      <Shortcut Id="StartmenuEintrag"
                Name="$(ProductName)"
                Description="Elektronische Rechnung aus einer vorhandenen PDF-Rechnung erstellen"
                Target="[INSTALLFOLDER]EInvoiceSender.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="StartmenuOrdnerEntfernen" Directory="StartmenuOrdner" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\$(ProductManufacturer)\$(ProductName)"
                     Name="Startmenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Optionale Desktopverknüpfung -->
    <Component Id="DesktopVerknuepfung" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopEintrag"
                Name="$(ProductName)"
                Target="[INSTALLFOLDER]EInvoiceSender.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\$(ProductManufacturer)\$(ProductName)"
                     Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
