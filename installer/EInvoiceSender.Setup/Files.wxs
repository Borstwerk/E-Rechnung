<?xml version="1.0" encoding="UTF-8"?>
<!--
  Die zu installierenden Dateien.

  Der Inhalt wird beim Bauen aus dem Veröffentlichungsverzeichnis eingelesen
  (HarvestDirectory). So ist ausgeschlossen, dass eine neu hinzugekommene
  Laufzeitdatei vergessen wird – ein häufiger Fehler bei von Hand gepflegten
  Dateilisten.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="AnwendungsDateien" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**" />

      <!--
        Die Anwenderübersicht kommt absichtlich unmittelbar aus dem
        Repository und nicht aus dem Publish-Verzeichnis. Der Installer wird
        in der CI gebaut, bevor die portable Fassung ihre Hinweise erhält;
        eine Kopie im Publish wäre deshalb keine verlässliche MSI-Quelle.
      -->
      <Component Id="Drittanbieterhinweis" Directory="INSTALLFOLDER" Guid="*">
        <File Id="DrittanbieterhinweisDatei"
              Source="..\Drittanbieterhinweise\README.md"
              Name="Drittanbieterhinweise.md" />
      </Component>

      <!-- Vollständige, an den Primärquellen geprüfte Lizenz-/Notice-Texte. -->
      <Files Include="..\Drittanbieterhinweise\Lizenzen\**"
             Directory="DrittanbieterLizenzordner" />
    </ComponentGroup>
  </Fragment>
</Wix>
