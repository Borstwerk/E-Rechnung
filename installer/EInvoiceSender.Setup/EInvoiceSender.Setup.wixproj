<Project Sdk="WixToolset.Sdk/5.0.2" InitialTargets="EnsureAuthorizedInstallerBuild">

  <!--
    Windows-Installer (MSI).

    Bewusst NICHT Teil von EInvoiceSender.sln: WiX erzeugt MSI-Dateien nur
    unter Windows. Auf einem Linux-Agenten würde die Solution sonst nicht mehr
    bauen. Der Installer wird ausschließlich im Windows-Job der CI gebaut.

    **Dieses Projekt wird nicht direkt gebaut.** Es gibt genau zwei
    unterstützte Einstiege:

      build\Build-Installer.ps1   nur das MSI
      build\Build-Release.ps1     vollständiger Releaseweg

    Beide veröffentlichen die Anwendung vorher frisch. Ein direkter Aufruf
    von `dotnet build` oder ein Bau aus Visual Studio heraus bricht ab; der
    Grund steht bei EnsureAuthorizedInstallerBuild.
  -->

  <PropertyGroup>
    <!--
      Der Dateiname der MSI. Er ist das, was der Anwender herunterlädt und im
      Downloadordner wiederfindet, und heißt deshalb wie das Produkt.

      Der Projektname der Installerdatei bleibt davon unberührt: Er ist eine
      Kennung, und Pfade darauf stehen im gemeinsamen Releaseweg, in
      Build-Installer.ps1 und in den Prüfungen.
    -->
    <OutputName>BorstWerk-E-Rechnung-Setup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>

    <!--
      WiX kennt keine portablen Symboldateien.

      Directory.Build.props setzt für die .NET-Projekte
      <DebugType>portable</DebugType>; diese Einstellung greift auch hier, weil
      die Datei im Wurzelverzeichnis liegt. Die WiX-SDK reicht $(DebugType)
      unverändert als PdbType an wix.exe weiter, und der lehnt "portable" mit
      WIX0268 ab. Für ein MSI wird ohnehin keine Symboldatei gebraucht, also
      "none" – gesetzt hier im Installerprojekt, damit die .NET-Projekte ihre
      portablen Symboldateien behalten.
    -->
    <DebugType>none</DebugType>

    <!-- Zentral gepflegte Produktangaben -->
    <!--
      Der sichtbare Name. Er bestimmt den Eintrag in „Apps und Features“, den
      Startmenüordner und – zusammen mit dem Hersteller – das
      Installationsverzeichnis.

      Der **Datenordner der Anwendung** ändert sich dadurch ausdrücklich
      nicht: Vorlage, Einstellungen und Protokolle liegen weiterhin unter
      %LOCALAPPDATA%\EInvoiceSender. Ihn mit umzubenennen hieße, jedem
      vorhandenen Anwender beim Aktualisieren seine Firmenvorlage zu
      verstecken – für einen Namen ein schlechter Tausch.
    -->
    <ProductName>BorstWerk E-Rechnung</ProductName>
    <ProductManufacturer>BorstWerk</ProductManufacturer>
    <!--
      Identitäten der veröffentlichten Produktfassungen.

      Ohne einen festen Wert erzeugt WiX bei jedem Bau einen neuen ProductCode.
      Zwei Pakete mit derselben ProductVersion, aber verschiedenen ProductCodes
      gelten dann als zwei Produkte: MajorUpgrade erfasst gleiche Versionen
      bewusst nicht. Genau so konnte 0.1.0 mehrfach installiert werden.

      Die zentrale Version wählt genau einen festen Code aus. Der veröffentlichte
      0.1.0-Code bleibt als historische Zuordnung bestehen; 0.2.0 erhält einen
      neuen Code. Eine unbekannte Version wird vor dem WiX-Bau abgelehnt. Der
      UpgradeCode in Package.wxs bleibt dagegen über alle Fassungen stabil.
    -->
    <ProductCode Condition="'$(VersionPrefix)' == '0.1.0'">723d8a8e-cb3d-4ec0-81d2-3821a56be91d</ProductCode>
    <ProductCode Condition="'$(VersionPrefix)' == '0.2.0'">f69b7118-58e7-4bb9-b4ff-411056aa3776</ProductCode>
    <!--
      Die Fassungsnummer steht in Directory.Build.props als VersionPrefix und
      wird ohne eigene ProductVersion-Eigenschaft an WiX weitergegeben. Diese
      Datei liegt im Wurzelverzeichnis und gilt auch für dieses Projekt. Damit
      tragen MSI und Programmdatei dieselbe Fassung, örtlich wie in der CI.
    -->

    <!--
      Verzeichnis der zuvor veröffentlichten Anwendung.

      **Bewusst ohne Vorgabewert.** Früher stand hier
      ..\..\artifacts\publish\win-x64\. Damit genügte ein direkter Build, um
      den Inhalt dieses Ordners zu paketieren – gleich, wie alt er war. Ein
      liegengebliebener Bestand darf nie allein dadurch zur Installerquelle
      werden, dass jemand das Projekt baut. Den Pfad setzt ausschließlich
      Build-Installer.ps1, und zwar auf das Verzeichnis, das es unmittelbar
      zuvor selbst frisch veröffentlicht hat.

      Diese Zeile hält fest, ob der Pfad tatsächlich von außen kam.

      **Sie sieht überflüssig aus und ist es nicht.** Auf $(PublishDir)
      direkt zu prüfen wäre wirkungslos: Microsoft.Common.targets wird erst
      nach dem Projektkörper eingebunden und setzt dort einen eigenen
      Vorgabewert – gemessen bin/Release/app.publish/. Zum Zeitpunkt des
      Wächters ist $(PublishDir) also nie leer, auch wenn niemand ihn
      angegeben hat. Hier oben, vor jenem Import, ist er es. Wer das später
      zu "Condition='$(PublishDir)' == ''" vereinfacht, schaltet den Wächter
      still ab.
    -->
    <BorstWerkSuppliedPublishDir>$(PublishDir)</BorstWerkSuppliedPublishDir>

    <DefineConstants>
      ProductName=$(ProductName);
      ProductManufacturer=$(ProductManufacturer);
      ProductCode=$(ProductCode);
      ProductVersion=$(VersionPrefix);
      PublishDir=$(PublishDir)
    </DefineConstants>
  </PropertyGroup>

  <!--
    Wächter gegen veralteten Veröffentlichungsbestand.

    Am 25.08.2026 entstand aus einem direkten Build dieses Projekts ein MSI
    mit der Produktversion 0.2.0, dessen Programmdateien aus einem älteren
    Quellstand stammten: Der alte Publish lag noch im damaligen
    Standardordner und wurde stillschweigend paketiert. Keine
    Versionsprüfung konnte das bemerken, weil auch der alte Bestand schon
    VersionPrefix 0.2.0 trug – die Angaben stimmten, der Inhalt nicht.

    Der Grundsatz dahinter: Ein Build, der sich bei der Frische seiner
    Eingaben nicht sicher ist, muss abbrechen. Stillschweigend Altbestand zu
    paketieren ist schlimmer als eine Verweigerung, weil das Ergebnis echt
    aussieht.

    Der Wächter hängt an InitialTargets und läuft damit vor jedem anderen
    Ziel. Das ist Absicht: Eine spätere Prüfung – ProductCode, fehlende
    Datei, WiX selbst – würde einen unerlaubten Build nur zufällig fangen,
    und zwar erst, nachdem er bereits Arbeit geleistet hat.

    Auch die Reihenfolge der beiden Meldungen ist Absicht: Wer ohne
    Autorisierung baut, soll den richtigen Weg genannt bekommen und nicht
    eine fehlende Eigenschaft, die ihn gar nichts angeht.
  -->
  <Target Name="EnsureAuthorizedInstallerBuild">
    <Error Condition="'$(BorstWerkInstallerBuild)' != 'true'"
           Text="Das Installerprojekt wird nicht direkt gebaut. Verwenden Sie build\Build-Installer.ps1 (nur das MSI) oder build\Build-Release.ps1 (vollständiger Releaseweg). Beide veröffentlichen die Anwendung vorher frisch. Ein direkter Build würde einen bereits vorhandenen, möglicherweise veralteten Veröffentlichungsbestand paketieren; die Versionsangaben des MSI wären dann korrekt, sein Inhalt nicht." />
    <Error Condition="'$(BorstWerkSuppliedPublishDir)' == ''"
           Text="PublishDir wurde nicht übergeben. Der Installerbau bricht ab, damit kein vorhandener Standardordner allein durch sein Dasein zur Installerquelle wird. Build-Installer.ps1 setzt den Pfad auf das Verzeichnis, das es unmittelbar zuvor selbst veröffentlicht hat." />
  </Target>

  <Target Name="ValidateProductIdentity" BeforeTargets="CoreCompile">
    <Error Condition="'$(ProductCode)' == ''"
           Text="Für die Produktversion $(VersionPrefix) ist kein fester ProductCode hinterlegt. Der Installerbau wird abgebrochen." />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
