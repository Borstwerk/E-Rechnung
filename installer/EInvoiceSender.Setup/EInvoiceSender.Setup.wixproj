<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Windows-Installer (MSI).

    Bewusst NICHT Teil von EInvoiceSender.sln: WiX erzeugt MSI-Dateien nur
    unter Windows. Auf einem Linux-Agenten würde die Solution sonst nicht mehr
    bauen. Der Installer wird ausschließlich im Windows-Job der CI gebaut.

    Bauen:
      dotnet build installer/EInvoiceSender.Setup -c Release ^
        -p:PublishDir=..\..\artifacts\publish\win-x64\ ^
        -p:ProductVersion=0.1.0
  -->

  <PropertyGroup>
    <OutputName>EInvoiceSender-Setup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>

    <!--
      WiX kennt keine portablen Symboldateien.

      Directory.Build.props setzt für die .NET-Projekte
      <DebugType>portable</DebugType>; diese Einstellung greift auch hier, weil
      die Datei im Wurzelverzeichnis liegt. Die WiX-SDK reicht $(DebugType)
      unverändert als PdbType an wix.exe weiter, und der lehnt "portable" mit
      WIX0268 ab. Für ein MSI wird ohnehin keine Symboldatei gebraucht, also
      "none" – gesetzt hier im Installerprojekt, damit die .NET-Projekte ihre
      portablen Symboldateien behalten.
    -->
    <DebugType>none</DebugType>

    <!-- Zentral gepflegte Produktangaben -->
    <!--
      Der sichtbare Name. Er bestimmt den Eintrag in „Apps und Features“, den
      Startmenüordner und – zusammen mit dem Hersteller – das
      Installationsverzeichnis.

      Der **Datenordner der Anwendung** ändert sich dadurch ausdrücklich
      nicht: Vorlage, Einstellungen und Protokolle liegen weiterhin unter
      %LOCALAPPDATA%\EInvoiceSender. Ihn mit umzubenennen hieße, jedem
      vorhandenen Anwender beim Aktualisieren seine Firmenvorlage zu
      verstecken – für einen Namen ein schlechter Tausch.
    -->
    <ProductName>BorstWerk E-Rechnung</ProductName>
    <ProductManufacturer>BorstWerk</ProductManufacturer>
    <!--
      Die Fassungsnummer steht in Directory.Build.props als VersionPrefix und
      sonst nirgends. Diese Datei liegt im Wurzelverzeichnis und gilt auch
      für dieses Projekt, also lässt sich die Angabe von dort übernehmen,
      statt sie ein zweites Mal zu pflegen – zwei Zahlen laufen früher oder
      später auseinander, und dann trägt die MSI eine andere Fassung als die
      Programmdatei darin.

      Ein Aufruf mit -p:ProductVersion=... hat weiterhin Vorrang; die CI
      setzt für eine Vorabfassung eine eigene Nummer.
    -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(VersionPrefix)</ProductVersion>

    <!-- Verzeichnis der zuvor veröffentlichten Anwendung -->
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\win-x64\</PublishDir>

    <DefineConstants>
      ProductName=$(ProductName);
      ProductManufacturer=$(ProductManufacturer);
      ProductVersion=$(ProductVersion);
      PublishDir=$(PublishDir)
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
