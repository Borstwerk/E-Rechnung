<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Windows-Installer (MSI).

    Bewusst NICHT Teil von EInvoiceSender.sln: WiX erzeugt MSI-Dateien nur
    unter Windows. Auf einem Linux-Agenten würde die Solution sonst nicht mehr
    bauen. Der Installer wird ausschließlich im Windows-Job der CI gebaut.

    Bauen:
      dotnet build installer/EInvoiceSender.Setup -c Release ^
        -p:PublishDir=..\..\artifacts\publish\win-x64\
  -->

  <PropertyGroup>
    <!--
      Der Dateiname der MSI. Er ist das, was der Anwender herunterlädt und im
      Downloadordner wiederfindet, und heißt deshalb wie das Produkt.

      Der Projektname der Installerdatei bleibt davon unberührt: Er ist eine
      Kennung, und Pfade darauf stehen im gemeinsamen Releaseweg, in
      Build-Installer.ps1 und in den Prüfungen.
    -->
    <OutputName>BorstWerk-E-Rechnung-Setup</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>

    <!--
      WiX kennt keine portablen Symboldateien.

      Directory.Build.props setzt für die .NET-Projekte
      <DebugType>portable</DebugType>; diese Einstellung greift auch hier, weil
      die Datei im Wurzelverzeichnis liegt. Die WiX-SDK reicht $(DebugType)
      unverändert als PdbType an wix.exe weiter, und der lehnt "portable" mit
      WIX0268 ab. Für ein MSI wird ohnehin keine Symboldatei gebraucht, also
      "none" – gesetzt hier im Installerprojekt, damit die .NET-Projekte ihre
      portablen Symboldateien behalten.
    -->
    <DebugType>none</DebugType>

    <!-- Zentral gepflegte Produktangaben -->
    <!--
      Der sichtbare Name. Er bestimmt den Eintrag in „Apps und Features“, den
      Startmenüordner und – zusammen mit dem Hersteller – das
      Installationsverzeichnis.

      Der **Datenordner der Anwendung** ändert sich dadurch ausdrücklich
      nicht: Vorlage, Einstellungen und Protokolle liegen weiterhin unter
      %LOCALAPPDATA%\EInvoiceSender. Ihn mit umzubenennen hieße, jedem
      vorhandenen Anwender beim Aktualisieren seine Firmenvorlage zu
      verstecken – für einen Namen ein schlechter Tausch.
    -->
    <ProductName>BorstWerk E-Rechnung</ProductName>
    <ProductManufacturer>BorstWerk</ProductManufacturer>
    <!--
      Identitäten der veröffentlichten Produktfassungen.

      Ohne einen festen Wert erzeugt WiX bei jedem Bau einen neuen ProductCode.
      Zwei Pakete mit derselben ProductVersion, aber verschiedenen ProductCodes
      gelten dann als zwei Produkte: MajorUpgrade erfasst gleiche Versionen
      bewusst nicht. Genau so konnte 0.1.0 mehrfach installiert werden.

      Die zentrale Version wählt genau einen festen Code aus. Der veröffentlichte
      0.1.0-Code bleibt als historische Zuordnung bestehen; 0.2.0 erhält einen
      neuen Code. Eine unbekannte Version wird vor dem WiX-Bau abgelehnt. Der
      UpgradeCode in Package.wxs bleibt dagegen über alle Fassungen stabil.
    -->
    <ProductCode Condition="'$(VersionPrefix)' == '0.1.0'">723d8a8e-cb3d-4ec0-81d2-3821a56be91d</ProductCode>
    <ProductCode Condition="'$(VersionPrefix)' == '0.2.0'">f69b7118-58e7-4bb9-b4ff-411056aa3776</ProductCode>
    <!--
      Die Fassungsnummer steht in Directory.Build.props als VersionPrefix und
      wird ohne eigene ProductVersion-Eigenschaft an WiX weitergegeben. Diese
      Datei liegt im Wurzelverzeichnis und gilt auch für dieses Projekt. Damit
      tragen MSI und Programmdatei dieselbe Fassung, örtlich wie in der CI.
    -->

    <!-- Verzeichnis der zuvor veröffentlichten Anwendung -->
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\win-x64\</PublishDir>

    <DefineConstants>
      ProductName=$(ProductName);
      ProductManufacturer=$(ProductManufacturer);
      ProductCode=$(ProductCode);
      ProductVersion=$(VersionPrefix);
      PublishDir=$(PublishDir)
    </DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateProductIdentity" BeforeTargets="CoreCompile">
    <Error Condition="'$(ProductCode)' == ''"
           Text="Für die Produktversion $(VersionPrefix) ist kein fester ProductCode hinterlegt. Der Installerbau wird abgebrochen." />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
